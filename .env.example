# 주소 — 넣지 않으면 brand.ts 의 SITE_URL_DEFAULT(https://radiation-lab.com)를 쓴다
SITE_URL=

# 로그인·저장 — 플랫폼이 함께 쓰는 Supabase 프로젝트. 두 값이 **모두** 있어야 저장이 켜진다.
# ★ 없으면 도구는 그대로 돌고 저장 막대만 조용히 사라진다(의도된 동작).
# ★ astro.config.mjs 의 vite.envPrefix 가 VITE_ 를 열어 둔다 — 지우면 빌드는 통과하고
#   로그인만 영영 꺼진 채 배포된다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
