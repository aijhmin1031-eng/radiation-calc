{
  "name": "radiation-calc",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "tsx --test src/engine/*.test.ts src/lib/*.test.ts src/validation/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && astro check",
    "gate": "node gate/check-gates.mjs && node gate/check-output.mjs && node gate/check-render.mjs && node gate/check-lockup.mjs && node gate/check-inputs.mjs && node gate/check-save.mjs && node gate/check-sticky.mjs && node gate/check-header.mjs && node gate/check-platform.mjs && node gate/check-nuclides.mjs && node gate/check-og.mjs && node gate/check-lastmod.mjs && node gate/check-adsense.mjs && tsx gate/check-validation.mjs",
    "make-keywords": "node scripts/make-keywords.mjs",
    "make-dataset": "tsx scripts/make-dataset.mjs",
    "make-og": "node scripts/make-og.mjs",
    "check-og": "node gate/check-og.mjs",
    "check-validation": "tsx gate/check-validation.mjs",
    "check-gates": "node gate/check-gates.mjs",
    "check-adsense": "node gate/check-adsense.mjs",
    "check-lastmod": "node gate/check-lastmod.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^6.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "astro": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
