---
/**
 * 공유 줄 — **SDK 를 붙이지 않는다.**
 *
 * ★★ 계기(2026-09-15 소유주 지시 「페이스북 인스타 쓰레드 등으로 추천하기 쉽게 세팅」).
 *
 * ★★ **맨 `<a>` 링크뿐이다.** 페이스북·카카오 SDK 를 실으면 이 사이트의 방어선인
 *   **제3자 요청 0건**이 깨지고 **동의 배너 이전에** 방문자 IP 가 그쪽으로 나간다.
 *   링크는 **누르기 전에는 요청이 0** 이다.
 *
 * ★ **인스타그램은 웹 공유 인텐트가 없다** — 앱이 외부에서 글을 미리 채워 열어 주지 않는다.
 *   카카오톡도 SDK 없이는 안 된다. 그 둘의 답이 **「링크 복사」**이고, 그래서 복사가
 *   맨 앞에 온다(가장 자주 쓰일 것이다).
 *
 * ★ 복사는 `navigator.clipboard` 가 막힌 곳(구형·비보안 문맥)이 있으므로 실패를 삼키지 않고
 *   **주소를 그대로 보여 주는 자리**로 떨어뜨린다 — 「복사됨」이라고 거짓말하지 않는다.
 */
import { canonical } from "../lib/site";
interface Props { title: string }
const { title } = Astro.props;
const url = canonical(Astro.url.pathname);
const text = `${title} — Radiation Lab`;
const enc = encodeURIComponent;
const LINKS = [
  { label: "X", href: `https://x.com/intent/post?text=${enc(text)}&url=${enc(url)}` },
  { label: "Threads", href: `https://www.threads.net/intent/post?text=${enc(`${text} ${url}`)}` },
  { label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}` },
  { label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}` },
];
---

<aside class="share not-prose" aria-label="Share this page">
  <span class="share-l">Share</span>
  <button type="button" class="share-b" data-share-copy data-url={url}>Copy link</button>
  {LINKS.map((l) => (
    <a class="share-b" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
  ))}
  <span class="share-s" data-share-status role="status" aria-live="polite"></span>
</aside>

<style is:global>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
           margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid rgb(var(--c-line)); }
  .share-l { font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
             color: rgb(var(--c-ink-faint)); margin-right: 4px; }
  /* 손가락 표적 24px(WCAG 2.5.8) — 13px 글자는 줄 높이가 18px 뿐이다. */
  .share-b { display: inline-flex; align-items: center; min-height: 28px; padding: 4px 10px;
             font-size: 13px; color: rgb(var(--c-ink-muted)); text-decoration: none;
             border: 1px solid rgb(var(--c-line)); border-radius: 6px; background: none;
             cursor: pointer; font-family: inherit; }
  .share-b:hover { color: rgb(var(--c-ink)); background: rgb(var(--c-accent-soft)); }
  .share-b:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 2px; }
  .share-s { font-size: 12px; color: rgb(var(--c-ink-faint)); }
  @media print { .share { display: none !important; } }
</style>

<script is:inline>
  (function () {
    var b = document.querySelector("[data-share-copy]");
    var s = document.querySelector("[data-share-status]");
    if (!b) return;
    b.addEventListener("click", function () {
      var url = b.getAttribute("data-url") || location.href;
      var ok = function () { if (s) { s.textContent = "Copied"; setTimeout(function () { s.textContent = ""; }, 2400); } };
      var no = function () { if (s) s.textContent = url; };
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(ok, no);
        else no();
      } catch (e) { no(); }
    });
  })();
</script>
