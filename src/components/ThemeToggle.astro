---
/**
 * 라이트/다크 전환 — 사이트 쪽(머리글)용.
 *
 * ★ 왜 만들었나(2026-09-08, 소유주 지시): 전환 버튼이 **도구 화면 안에만** 있었다.
 *   `v2/src/components/Sidebar.tsx` 의 `ThemeToggle` 이 유일한 자리이고, 사이트 33쪽은
 *   `Base`·`AppShell` 의 부팅 스크립트로 저장된 테마를 **읽기만** 했다.
 *   실측: `/`·`/standards/`·`/guides/` 에서 테마 컨트롤 0개, `/app/` 에서 2개.
 *   해설을 읽는 사람은 도구를 열지 않고도 눈이 편한 쪽을 고를 수 있어야 한다.
 *
 * ★ 저장 자리는 **도구와 한 곳**이다 — zustand persist 키 `radmeter-v2-theme` 에
 *   `{"state":{"mode","resolved"},"version":0}` 형식 그대로 쓴다(실측으로 확인한 형식이다).
 *   그래서 사이트에서 고른 것이 도구에 따라오고, 도구에서 고른 것이 사이트에 따라온다.
 *   형식을 어기면 **부팅 스크립트가 조용히 system 으로 되돌린다**(빌드는 통과한다).
 *
 * ★ 보이는 것은 **CSS 가 정한다**(2026-09-26 부터 글자가 아니라 해·달 그림이다).
 *   JS 로 넣으면 부팅 스크립트가 이미 칠해 놓은
 *   화면 위에 한 박자 늦게 덮어써 **첫 그림에 반대 글자**가 보인다. `data-theme` 은
 *   그리기 전에 박히므로 CSS 는 처음부터 맞다. JS 가 하는 것은 클릭과 `aria-pressed` 뿐이다.
 *
 * ★ `<style is:global>` 안에서는 **맨 선택자**를 쓴다 — 스코프 CSS 는 `[data-theme]` 을 든
 *   `<html>` 에 닿지 못하고(그 요소에는 cid 가 없다), `is:global` 안의 `:global()` 은
 *   문자열 그대로 나가 규칙을 죽인다(CLAUDE.md 함정 ⑦).
 *
 * ★ `aria-label` 은 상태에 무관하게 참인 문구로 둔다 — 상태를 담으면 JS 가 붙기 전 한 박자
 *   동안 틀린 안내가 된다. 상태는 `aria-pressed` 가 든다.
 */
interface Props {
  /** 도구 화면 상단 띠처럼 더 작게 들어가는 자리 */
  compact?: boolean;
  /** ★ 좁은 화면에서만 조인다 — 모바일 머리글은 줄이 하나 늘 때마다 40px 씩 먹는다.
   *  ★ 2026-09-26: 글자는 이제 없다(해·달 그림 하나다). 그림이 뜻을 들므로 좁은 화면에서도
   *    버릴 것이 없고, 이 속성이 조이는 것은 **여백뿐**이다. */
  compactOnMobile?: boolean;
}
const { compact = false, compactOnMobile = false } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle light and dark theme"
  title="Light / dark theme"
  class:list={[
    "rmt-theme shrink-0 inline-flex items-center gap-1.5 rounded-md border border-line",
    "font-medium text-ink-muted hover:text-ink hover:bg-accent-soft transition-colors",
    compact
      ? "px-2 py-1 text-[11px]"
      : compactOnMobile
        ? "px-1.5 py-2 text-[10px] sm:px-2.5 sm:py-1.5 sm:text-[11px]"
        : "px-2.5 py-2.5 sm:py-1.5 text-[11px]",
  ]}
>
  <svg class="rmt-theme-ic" viewBox="0 0 16 16" aria-hidden="true" fill="none"
       stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <g class="rmt-theme-on-light"><circle cx="8" cy="8" r="3.1" /><path
      d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M12.95 3.05l-1.13 1.13M4.18 11.82l-1.13 1.13" /></g>
    <g class="rmt-theme-on-dark"><path d="M13.2 9.6A5.6 5.6 0 0 1 6.4 2.8a5.6 5.6 0 1 0 6.8 6.8z" /></g>
  </svg>
</button>

<style is:global>
  /* ★★ 2026-09-26 — 점과 낱말을 **해·달 한 그림**으로 바꿨다(소유주 지시: 플랫폼 전체를
     같은 표시로). 우산(`radiation-lab.com`)이 먼저 바꾸었고 이 자리가 따라온다.
     ★ 그전 주석이 「글자는 버리지 않는다 — 점만 남기면 무엇을 누르는 것인지 알 수 없다」고
       적고 있었고 그 판단은 **옳았다**. 바뀐 것은 전제다: 점은 뜻이 없지만 **해와 달은 뜻이
       있다.** 그래서 낱말 없이도 무엇을 누르는지 알 수 있고, 좁은 화면에서 낱말을 접느라
       머리글 높이를 쓰던 문제가 함께 사라진다(우산 실측: 낱말을 되살리면 360·390px 에서
       머리글이 63 → 87px 두 줄이 됐다).
     ★ 고르는 것은 여전히 **CSS 다** — `data-theme` 은 첫 그림 전에 박히므로 처음부터 맞다.
       JS 로 고르면 부팅 스크립트가 칠한 화면 위에 한 박자 늦게 **반대 그림**이 덮인다.
     ★ 지금 상태를 든다(밝으면 해, 어두우면 달) — 낱말이 그랬던 것과 같다. */
  .rmt-theme-ic { width: 15px; height: 15px; flex: none; }
  .rmt-theme-on-dark { display: none; }
  [data-theme="dark"] .rmt-theme-on-light { display: none; }
  [data-theme="dark"] .rmt-theme-on-dark { display: inline; }
  /* 낱말이 빠지면 상자가 그림만큼 좁아진다 — 누를 자리는 그대로 두어야 한다. */
  .rmt-theme { min-width: 34px; justify-content: center; }
  .rmt-theme:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 2px; }
  @media print { .rmt-theme { display: none !important; } }
</style>

<script>
  const KEY = "radmeter-v2-theme";

  function currentMode(): "light" | "dark" | "system" {
    try {
      const raw = localStorage.getItem(KEY);
      const mode = raw ? (JSON.parse(raw).state || {}).mode : "system";
      return mode === "light" || mode === "dark" ? mode : "system";
    } catch {
      return "system";
    }
  }

  function resolve(mode: "light" | "dark" | "system"): "light" | "dark" {
    if (mode === "light" || mode === "dark") return mode;
    return window.matchMedia?.("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function apply(mode: "light" | "dark") {
    document.documentElement.dataset.theme = mode;
    try {
      localStorage.setItem(KEY, JSON.stringify({ state: { mode, resolved: mode }, version: 0 }));
    } catch {
      /* 사생활 보호 모드에서는 저장이 막힌다 — 그 경우에도 이번 화면은 바뀌어야 한다. */
    }
    sync();
  }

  function sync() {
    const dark = document.documentElement.dataset.theme === "dark";
    for (const el of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      el.setAttribute("aria-pressed", String(dark));
    }
  }

  for (const el of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    el.addEventListener("click", () => apply(resolve(currentMode()) === "dark" ? "light" : "dark"));
  }
  sync();
</script>
