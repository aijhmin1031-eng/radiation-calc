---
import Base from "../layouts/Base.astro";
import { u, DATA_SOURCES } from "../lib/site";
import { TOOLS, toolBySlug } from "../lib/tools";
import { SAVE_ENABLED } from "../lib/features";
import ToolIcon from "./ToolIcon.astro";
interface Props { slug: string }
const { slug } = Astro.props;
const tool = toolBySlug(slug)!;
---
{/* ★★ 세 칸 구성(2026-09-14 소유주 제안 「좌측에 메뉴, 가운데 본문, 우측에 관련 정보」).
    실측이 제안을 뒷받침했다 — 단칸일 때 **숫자 하나 넣는 칸이 1036~1070px** 였다.
    본문이 1152px 로 묶여 있는데 그 안에서 입력칸이 전폭으로 늘어난 것이다.
    세 칸으로 가르면 가운데가 약 592px 이 되어 **입력칸이 제 크기를 찾는다**(좁아지는 것이 아니다).

    ★ **해설은 우측 레일에 넣지 않는다.** 지금 해설이 459~594어 · 768px 폭에 1016~1266px 높이인데,
      300px 레일에 넣으면 높이가 약 2.5배가 되고 한 줄이 40자로 떨어진다. 읽기가 나빠지고,
      이 글이 애드센스 관점에서 **사이트의 값어치 그 자체**다. 가운데 칸에 두면 한 줄이
      102자 → 약 81자가 되어 오히려 조판 관행(45~90자)에 들어온다.

    ★ 우측 레일에는 **레일 모양인 것만** 둔다 — 가정·한계, 데이터 출처, 저장, 관련 도구.

    ★ 세 칸은 **xl(1280px) 부터**다. 그 아래에서는 한 칸으로 흐르고 레일 내용이 본문 뒤에 이어진다
      (1024px 에서 세 칸으로 가르면 가운데가 496px 이라 입력 두 칸이 212px 로 눌린다).
    ★ 좁은 화면에서 도구 목록을 잃지 않는다 — 머리글의 `Calculators` 칸과 빵부스러기,
      그리고 아래쪽 「Other calculators」가 그 자리를 맡는다. */}
<Base title={tool.name} description={tool.blurb}>
  <div class="xl:grid xl:grid-cols-[13rem_minmax(0,1fr)_16rem] xl:items-start xl:gap-8">

    {/* ── 좌: 도구 목록. 이 lab 에서 가장 자주 하는 이동이다 ── */}
    <nav aria-label="Calculators" class="hidden xl:block xl:sticky xl:top-4">
      <p class="label">Calculators</p>
      <ul class="mt-2 space-y-0.5">
        {TOOLS.map((t) => {
          const on = t.slug === slug;
          return (
            <li>
              <a href={u(`/${t.slug}/`)} aria-current={on ? "page" : undefined}
                 class:list={["flex items-start gap-2 rounded-md px-2 py-1.5 text-[13px] leading-snug no-underline transition-colors",
                   on ? "border border-accent/50 bg-accent-soft font-semibold text-ink"
                      : "border border-transparent text-ink-muted hover:border-line hover:text-ink"]}>
                {/* ★ 표식은 글자와 **첫 줄 기준선**을 맞춘다 — 이름이 두 줄로 감기는 칸이
                    있어(「Gamma dose rate and shielding」) 가운데 맞춤으로 두면 표식만 아래로 처진다. */}
                <ToolIcon slug={t.slug} class="mt-[1px]" />
                <span>{t.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    {/* ── 가운데: 계산과 해설 ── */}
    <div class="min-w-0">
      <nav class="tap-list mb-4 flex flex-wrap items-center gap-x-1.5 text-[12px] text-ink-faint">
        <a href={u("/")} class="hover:text-ink">Calculators</a> <span aria-hidden>/</span> {tool.name}
      </nav>

      <h1 class="text-[26px] font-semibold tracking-tight text-ink sm:text-[32px]">{tool.name}</h1>
      <p class="mt-2 text-[15px] leading-relaxed text-ink-muted">{tool.blurb}</p>
      <p class="mt-1.5 text-[13px] text-ink-faint">No sign-in needed. Nothing you type leaves your browser.</p>

      {/* ★ 아일랜드는 client:only 다 — 서버가 안 그리므로 자리 표시가 필요하다.
          JS 가 막힌 환경에서는 이 안내가 그대로 남는다(빈 상자보다 낫다). */}
      <section class="card mt-6 min-h-[18rem] p-4 sm:p-6">
        <slot name="tool" />
        <noscript>
          <p class="text-[14px] leading-relaxed text-ink-muted">
            This calculator runs in your browser and needs JavaScript enabled. The method and the data it
            uses are described below, and on the <a href={u("/methods/")} class="underline">methods page</a>.
          </p>
        </noscript>
      </section>

      <section class="prose-doc mt-12 space-y-4 text-[15px] leading-relaxed text-ink-muted">
        <slot name="prose" />
      </section>
    </div>

    {/* ── 우: 참고. 계산에 딸리지만 계산의 일부는 아닌 것 ── */}
    {/* ★ 붙박이(sticky) 인데 **화면보다 크면 아래가 영영 안 보인다** — 위 가장자리가
        top-4 에 박히고 나머지는 화면 밖에 남아 스크롤로도 닿지 않는다. 신뢰도 삼항을
        넣으면서 레일이 344 → 884px 이 되어 800px 화면에서 그 함정에 들어갔다.
        화면 높이로 상한을 두고 넘치면 레일 안에서 스크롤한다. */}
    <aside aria-label="Reference"
           class="mt-12 xl:mt-0 xl:sticky xl:top-4 xl:max-h-[calc(100vh-2rem)] xl:overflow-y-auto">
      <div class="card space-y-5 p-4 text-[13px]">
        {/* ★★ 신뢰도 삼항 — 정본은 `lib/tools.ts` 다. 쪽마다 적지 않는다.
            계산기를 믿을지는 **답이 아니라 답이 선 자리**를 보고 정한다.
            ★ 「다루지 않는 것」을 함께 드는 것이 핵심이다 — 경계를 밝히지 않는 계산기는
              쓰는 사람이 **범위 밖에서 쓴 줄도 모르게** 만든다. */}
        <div>
          <p class="label">What this assumes</p>
          <ul class="mt-1.5 space-y-1.5 text-ink-muted">
            {tool.assumes.map((x) => <li class="leading-snug">{x}</li>)}
          </ul>
        </div>

        <div class="border-t border-line pt-4">
          <p class="label">What it does not answer</p>
          <ul class="mt-1.5 space-y-1.5 text-ink-muted">
            {tool.excludes.map((x) => <li class="leading-snug">{x}</li>)}
          </ul>
        </div>

        <div class="border-t border-line pt-4">
          <p class="label">Checked against</p>
          <p class="mt-1.5 leading-snug text-ink-muted">{tool.checked}</p>
        </div>

        <slot name="aside" />

        {/* ★ 좁은 화면에서는 **꼬리말이 이미** 데이터 출처와 도구 일곱을 들고 있다.
            레일을 그대로 흘려보내면 같은 목록이 한 쪽에 두 번 서고 쪽이 800px 길어진다.
            xl 에서만 든다 — 거기서는 꼬리말이 한참 아래라 손에 닿지 않는다. */}
        <div class="hidden border-t border-line pt-4 xl:block">
          <p class="label">Data sources</p>
          <ul class="mt-1.5 space-y-1 text-ink-muted">
            {DATA_SOURCES.map((d) => (
              <li><a href={d.url} rel="noopener" class="hover:text-ink">{d.name}</a></li>
            ))}
          </ul>
          <p class="mt-2 leading-snug text-ink-faint">
            Constants are computed from these, not copied from a handbook table.
            <a href={u("/methods/")} class="ml-1 underline hover:text-ink">How</a>
          </p>
        </div>

        {/* ★ 저장이 꺼져 있으면 이 묶음도 걸지 않는다 — 머리글 칸만 막았다가
            **여기서 같은 거짓말이 새어 나왔다**(2026-09-14 실측). 「Google 로그인이 필요하다」고
            읽고 계산기를 봐도 저장 단추가 없다. 없는 기능을 말하는 자리는 **하나도 남기지 않는다.** */}
        {SAVE_ENABLED ? (
          <div class="xl:border-t xl:border-line xl:pt-4">
            <p class="label">Keep a result</p>
            <p class="mt-1.5 leading-snug text-ink-muted">
              Saving a calculation needs a Google sign-in. Everything else works without an account.
            </p>
            <a href={u("/saved/")} class="mt-2 inline-block underline hover:text-ink">Saved results</a>
          </div>
        ) : null}

        {/* ★ 도구 목록은 **세 곳에 두지 않는다** — xl 은 왼쪽 레일, 그 아래는 머리글의
            `Calculators` 칸·빵부스러기·꼬리말이 맡는다. 여기 또 두면 같은 말을 세 번 한다. */}
      </div>
    </aside>
  </div>
</Base>
