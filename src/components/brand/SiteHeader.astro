---
/**
 * 머리글 한 줄 — 브랜드 · Tools 메뉴 · 쪽 셋 · 테마·계정(2026-10-06 ⑥, 정본 명세 `C:\dev\rl\HEADER-SPEC.md`).
 *
 * ★★ 계기(2026-10-06 소유주): 「여기 상단에 놓아두는 2가지 영역이 다르네… 하나의 계산기 안에 다양한 도구가
 *   들어있는 형태로 구성해보자. 구조를 다시 잘 잡아봐」 → 시안 승인 「고」.
 *   그전에는 막대가 둘이었다 — 위는 분야 칸 셋(Dose & shielding · Instrument testing · Disposal & transport),
 *   아래는 lab 이름 `RadCalc` 과 칸 셋(Calculators · Nuclides · Methods). 위 칸은 **세 사이트**를, 아래 칸은
 *   **한 사이트 안의 쪽**을 가리켜 같은 모양의 칸이 다른 층을 말하고 있었다. 이제 apex 는 계산기 하나다 —
 *   도구 일곱은 `Tools` 메뉴 **안에** 있고, 다른 두 사이트는 메뉴 맨 아래 「More from Radiation Lab」 한 줄로 내렸다.
 * ★ 화면에 보이는 이름은 `Radiation Lab` 하나다(명세 §7). `RadCalc` 은 DOI 인용에만 남는다.
 * ★ 마크업 뼈대(`nav[aria-label="Main"] > details > summary` · 묶음 `ul[aria-labelledby]` · 이름 `b` · 한 줄 `em`)는 우산 홈과 같다 —
 *   두 레포의 `check-platform` 이 같은 함수로 잰다. 「Tools」 칸은 도구 쪽에서도 켜 두지 않는다(쪽이 아니라 메뉴다) — 지금 도구는
 *   메뉴 안의 칸과 왼쪽 목록이 표시한다.
 * ★ 메뉴는 `<details>` 다 — JS 가 없어도 열리고 닫힌다. 스크립트는 Escape(초점은 단추로) · 바깥 누르기만 더한다.
 * ★ 앰버를 막대에 쓰지 않는다(앰버는 활성·포커스·기준선 전용). 메뉴 안의 「지금 도구」만 accent-soft 바탕이다.
 */
import Icon from "../Icon.astro";
import { TOOL_GROUPS, toolsIn, menuName } from "../../lib/tools";
import { u } from "../../lib/site";

interface Props {
  /** 지금 쪽(base 붙은 pathname). 칸의 「현재」와 메뉴의 「지금 도구」를 판정한다. */
  here: string;
}
const { here } = Astro.props;
const HOME = "https://radiation-lab.com/";
/** 쪽 칸 — 순서·글자·주소 고정(명세 §3). 좁은 화면(<640px)은 짧은 글자. */
const PAGES = [
  { href: "/calc/nuclides/", wide: "Nuclide data", narrow: "Nuclides" },
  { href: "/calc/methods/", wide: "Methods", narrow: "Methods" },
  { href: "/calc/validation/", wide: "Validation", narrow: "Validation" },
] as const;
const MORE = [
  { href: "https://radimeter.radiation-lab.com/", label: "Instrument testing", icon: "gauge" },
  { href: "https://disposal.radiation-lab.com/", label: "Disposal & transport", icon: "layers" },
  /* ★ 2026-10-06 ⑦ 소유주 결정 — 셋째 자매 사이트(일상 도구 모음, 다른 세션이 세운 tools.radiation-lab.com). */
  { href: "https://tools.radiation-lab.com/", label: "Everyday tools", icon: "wrench" },
] as const;
const onPage = (href: string) => here.startsWith(href);
const toolOn = (slug: string) => here === u(`/${slug}/`);
---
<header data-site-header class="shdr">
  <div class="shdr-in mx-auto max-w-content px-5 sm:px-8">
    <a class="shdr-brand" href={HOME} aria-label="Radiation Lab — home">
      {/* 마크는 우산 `favicon.svg` 와 같은 좌표다(팔각 + 구). 색은 토큰 — 고정색이면 어두운 판에서 묻힌다. */}
      <svg class="shdr-mark" viewBox="0 0 64 64" aria-hidden="true">
        <polygon points="32.00,6.20 50.24,13.76 57.80,32.00 50.24,50.24 32.00,57.80 13.76,50.24 6.20,32.00 13.76,13.76"
                 fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="miter" />
        <circle cx="32" cy="32" r="15" fill="currentColor" opacity="0.82" />
      </svg>
      <span class="shdr-name">Radiation Lab</span>
    </a>
    <nav aria-label="Main" lang="en" class="shdr-nav">
      <details class="tmenu" data-tools-menu>
        <summary class="shdr-tab">
          Tools<Icon name="chevron-down" size={14} class="tmenu-chev" />
        </summary>
        <div class="tmenu-panel">
          <div class="tmenu-cols">
            {TOOL_GROUPS.map((g) => (
              <div class="tmenu-col">
                <p class="tmenu-h" id={`tm-${g.key}`}>{g.label}</p>
                <ul aria-labelledby={`tm-${g.key}`}>
                  {toolsIn(g.key).map((t) => (
                    <li>
                      <a class="tmenu-item" href={u(`/${t.slug}/`)} aria-current={toolOn(t.slug) ? "page" : undefined}>
                        <Icon name={t.icon} size={20} class="tmenu-ic" />
                        <span><b class="tmenu-n">{menuName(t)}</b><em class="tmenu-l">{t.line}</em></span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="tmenu-more">
            <span class="tmenu-h">More from Radiation Lab</span>
            {MORE.map((m) => (
              <a href={m.href}><Icon name={m.icon} size={16} />{m.label}<Icon name="arrow-up-right" size={13} class="tmenu-ext" /></a>
            ))}
          </div>
        </div>
      </details>
      {PAGES.map((p) => (
        <a class="shdr-tab" href={p.href} title={p.wide} aria-current={onPage(p.href) ? "page" : undefined}>
          <span class="shdr-wide">{p.wide}</span><span class="shdr-narrow">{p.narrow}</span>
        </a>
      ))}
    </nav>
    <div class="shdr-ctl"><slot /></div>
  </div>
</header>

<script is:inline>
  (function () {
    var ms = document.querySelectorAll("[data-tools-menu]");
    if (!ms.length) return;
    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      ms.forEach(function (m) {
        if (m.open) { m.open = false; var s = m.querySelector("summary"); if (s) s.focus(); }
      });
    });
    document.addEventListener("click", function (e) {
      ms.forEach(function (m) { if (m.open && !m.contains(e.target)) m.open = false; });
    });
  })();
</script>

<style is:global>
  /* ★★ 치수는 우산 홈 머리글(`radiation-lab` ab49970 의 `.hd`·`.tm`)과 **같은 값**이다 — 같은 오리진에서 쪽을 옮겨도
     막대가 한 픽셀도 안 움직여야 한다(소유주 「하나의 계산기」). 고치면 두 레포를 함께 고치고 `check-platform` 이 잰다.
     ★ 글줄 여백만 이 lab 의 것을 따른다(px-5 · sm:px-8) — 본문과 머리글이 같은 세로선에서 시작해야 한다. */
  /* ★ 머리글은 흐름 안(static)이다 — 판의 쌓임은 판 자신의 z-index 가 정한다(`check-sticky` ⑥: JS 없이 흐름에서 벗어나지 않는다). */
  .shdr { background: rgb(var(--c-panel)); border-bottom: 1px solid rgb(var(--c-line-strong)); }
  .shdr-in { position: relative; display: flex; align-items: center; gap: 12px 28px; padding-top: 9px; padding-bottom: 9px; line-height: 1.5; }
  .shdr-brand { display: inline-flex; align-items: center; gap: 8px; flex: none; min-height: 24px; color: rgb(var(--c-ink)); text-decoration: none; }
  .shdr-brand:hover .shdr-name { text-decoration: underline; }
  .shdr-mark { width: 24px; height: 24px; flex: none; color: rgb(var(--c-ink)); }
  .shdr-name { font-size: 16px; font-weight: 650; letter-spacing: -0.012em; white-space: nowrap; }
  .shdr-nav { display: flex; align-items: center; gap: 4px; min-width: 0; }
  .shdr-tab { display: inline-flex; align-items: center; gap: 5px; font-size: 14px; font-weight: 400; line-height: 1.5;
              padding: 7px 12px; border: 1px solid transparent; border-radius: 6px; color: rgb(var(--c-ink-muted));
              text-decoration: none; white-space: nowrap; cursor: pointer; list-style: none; background: none; user-select: none; }
  .shdr-tab::-webkit-details-marker { display: none; }
  .shdr-tab:hover { color: rgb(var(--c-ink)); }
  .shdr-tab[aria-current="page"], .tmenu[open] > .shdr-tab {
    color: rgb(var(--c-ink)); border-color: rgb(var(--c-line-strong)); background: rgb(var(--c-surface)); }
  .shdr-tab[aria-current="page"] { font-weight: 600; }
  .shdr-tab:focus-visible, .shdr-brand:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 2px; }
  .tmenu-chev { width: 14px; height: 14px; transition: transform .2s ease; }
  .tmenu[open] .tmenu-chev { transform: rotate(180deg); }
  .shdr-narrow { display: none; }
  .shdr-ctl { margin-left: auto; display: flex; align-items: center; gap: 10px; min-width: 0; }
  .shdr-ctl [data-acct-chip] { flex-shrink: 1; min-width: 0; }

  /* ── Tools 메뉴 판(명세 §4) — 머리글 안쪽 상자에 매달린다(글줄과 같은 세로선, 폰에서 오른쪽으로 안 넘친다) ── */
  .tmenu-panel { position: absolute; z-index: 50; top: calc(100% + 8px); left: 32px; width: min(820px, calc(100% - 64px));
    background: rgb(var(--c-surface)); border: 1px solid rgb(var(--c-line-strong)); border-radius: 10px;
    box-shadow: 0 18px 40px rgba(0,0,0,.12); padding: 22px 24px 0; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .tmenu-panel { box-shadow: 0 18px 40px rgba(0,0,0,.45); } }
  :root[data-theme="dark"] .tmenu-panel { box-shadow: 0 18px 40px rgba(0,0,0,.45); }
  .tmenu-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 28px; }
  .tmenu-h { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .14em;
             color: rgb(var(--c-ink-faint)); margin: 0 0 8px 10px; }
  .tmenu-col ul { list-style: none; margin: 0; padding: 0; }
  .tmenu-item { display: flex; gap: 12px; padding: 9px 10px; border-radius: 8px; color: rgb(var(--c-ink)); text-decoration: none; }
  .tmenu-item:hover, .tmenu-item:focus-visible { background: rgb(var(--c-panel)); }
  .tmenu-item:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 0; }
  .tmenu-item[aria-current="page"] { background: rgb(var(--c-accent-soft)); }
  .tmenu-ic { width: 20px; height: 20px; margin-top: 2px; color: rgb(var(--c-ink-muted)); }
  .tmenu-n { display: block; font-size: 14px; font-weight: 600; line-height: 1.4; color: rgb(var(--c-ink)); }
  .tmenu-l { display: block; font-style: normal; font-size: 12.5px; line-height: 1.45; color: rgb(var(--c-ink-muted)); }
  .tmenu-more { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 22px; margin: 16px -24px 0;
    padding: 9px 24px; background: rgb(var(--c-panel)); border-top: 1px solid rgb(var(--c-line)); border-radius: 0 0 10px 10px; }
  .tmenu-more .tmenu-h { margin: 0; }
  .tmenu-more a { display: inline-flex; align-items: center; gap: 6px; min-height: 28px; font-size: 13px; color: rgb(var(--c-ink)); text-decoration: none; }
  .tmenu-more a:hover { text-decoration: underline; }
  .tmenu-more a:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 2px; }
  .tmenu-more svg { width: 16px; height: 16px; color: rgb(var(--c-ink-muted)); }
  .tmenu-more svg.tmenu-ext { width: 13px; height: 13px; color: rgb(var(--c-ink-faint)); }

  /* 1024px 아래는 두 줄 — 브랜드·컨트롤, 그다음 칸 줄. 640px 아래는 짧은 글자·좁은 안여백, 360px 아래는 옆 안여백 6px. */
  @media (max-width: 1023.98px) {
    .shdr-in { flex-wrap: wrap; row-gap: 4px; padding-top: 8px; padding-bottom: 8px; }
    .shdr-ctl { flex: 1 1 0; justify-content: flex-end; }
    .shdr-nav { order: 3; flex: 1 0 100%; margin-left: -12px; }
  }
  @media (max-width: 639.98px) {
    .shdr-nav { gap: 2px; margin-left: -8px; }
    .shdr-tab { font-size: 13px; padding: 8px; }
    .shdr-wide { display: none; } .shdr-narrow { display: inline; }
    .tmenu-cols { grid-template-columns: 1fr; }
    .tmenu-panel { left: 20px; width: calc(100% - 40px); padding: 16px 14px 0; }
    .tmenu-more { margin-left: -14px; margin-right: -14px; padding-left: 14px; padding-right: 14px; }
  }
  @media (max-width: 359.98px) { .shdr-tab { padding: 8px 6px; } .shdr-nav { margin-left: -6px; } }
  @media (prefers-reduced-motion: reduce) { .tmenu-chev { transition: none; } }
</style>
