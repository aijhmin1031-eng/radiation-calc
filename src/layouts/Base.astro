---
import "../styles/global.css";
import { SITE_NAME, SITE_TAGLINE, UMBRELLA_NAME, DATA_SOURCES, u, canonical } from "../lib/site";
import { TOOLS } from "../lib/tools";
import { SAVE_ENABLED } from "../lib/features";
import Lockup from "../components/brand/Lockup.astro";
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
const here = Astro.url.pathname;
const full = `${title} · ${SITE_NAME}`;
/* 압축 바가 드는 「지금 어디」 — 쪽마다 적게 하지 않는다(쪽 제목에서 파생한다).
   ★ 허브에서는 비운다 — 칸 「Calculators」 가 이미 켜져 있어 같은 말이 두 번 나온다. */
const barLabel = here === u("/") ? "" : title;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={canonical(here)} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : null}
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical(here)} />
    {/* 그리기 전에 테마를 적용한다 — JS 로 글자를 넣으면 첫 그림에 반대 상태가 보인다 */}
    <script is:inline>
      try {
        const s = JSON.parse(localStorage.getItem("radmeter-v2-theme") || "null");
        const m = s && s.state && s.state.mode;
        if (m === "dark" || m === "light") document.documentElement.dataset.theme = m;
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-panel focus:px-3 focus:py-2">Skip to content</a>

    <header class="border-b border-line bg-panel">
      <div class="mx-auto flex max-w-content flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <Lockup labName={SITE_NAME} labHref={u("/")} />
        {/* ★ 다른 lab 으로 가는 칸을 두지 않는다(2026-09-14 소유주 지적
            「radcalc 페이지 메뉴에만 왜 radimeter 연결 탭이 있어?」).
            **lab 을 고르는 자리는 우산이다** — 잠금장치가 그리로 보낸다.
            여기에 두면 ① 다른 두 lab 에는 없어 불균형이고 ② lab 이 늘 때마다
            세 머리글을 다 고쳐야 하며 ③ 잠금장치와 같은 말을 두 번 한다. */}
        {/* ★ **도구 목록으로 돌아가는 칸이 없었다**(2026-09-14 소유주 지적
            「radcalc 상단 메뉴에 다시 첫 계산도구 선택하는 화면으로 못 돌아가잖아」).
            허브로 가는 길이 로고 글자와 빵부스러기 둘뿐이었는데 **둘 다 눈에 안 띄는 자리**다.
            도구를 고르는 것은 이 lab 에서 가장 자주 하는 이동이므로 첫 칸을 준다. */}
        <nav class="ml-auto flex flex-wrap gap-x-3 gap-y-1 text-[13px]">
          <a href={u("/")} aria-current={here === u("/") ? "page" : undefined}
             class:list={["hover:text-ink", here === u("/") ? "font-semibold text-ink" : "text-ink-muted"]}>Calculators</a>
          {/* ★ **없는 기능을 광고하지 않는다**(2026-09-14). 환경변수가 없으면 저장 막대가
              통째로 사라지는데 이 칸만 남아 있었다 — 눌러 가면 저장하는 법을 설명하는 낱장이
              나오고, 계산기로 돌아오면 저장 단추가 없다. 환경변수가 들어오면 저절로 켜진다. */}
          {SAVE_ENABLED ? <a href={u("/saved/")} class="text-ink-muted hover:text-ink">Saved</a> : null}
          <a href={u("/methods/")} class="text-ink-muted hover:text-ink">Methods</a>
        </nav>
      </div>
    </header>

    {/* ★★ **압축 고정 바** — 진짜 머리글(72px)은 흘려보내고, **지나친 뒤에만** 45px 바가 뜬다.
        머리글 전체를 고정하면 세로 공간을 영구히 뺏는다(모바일 844px 의 8.5%).
        · 센티넬 + IntersectionObserver 다 — `fixed` 는 흐름에서 자리를 안 먹으므로
          CSS 만으로는 「지나쳤는가」를 알 수 없다.
        · **JS 가 없으면 아무 일도 일어나지 않는다**(`visibility: hidden` 이 기본, 회귀 0).
        · 마크가 가리키는 곳은 잠금장치와 **같다**(우산 `/`) — 같은 글리프가 자리마다
          다른 곳으로 가면 읽는 사람이 둘을 다른 것으로 배운다.
        · 바가 생기는 순간 **`scroll-padding-top` 이 필요하다**(global.css 72px).
          없으면 앵커를 눌렀을 때 제목이 바 높이만큼 정확히 가린다. */}
    <div id="hdr-sentinel" aria-hidden="true" class="h-px"></div>

    <div id="topbar" data-on="false" class="topbar border-b border-line bg-panel">
      <div class="mx-auto flex h-[45px] max-w-content items-center gap-3 px-4">
        <a href="/" class="topbar-mark" aria-label="Radiation Lab — platform home">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <polygon points="32.00,6.20 50.24,13.76 57.80,32.00 50.24,50.24 32.00,57.80 13.76,50.24 6.20,32.00 13.76,13.76"
                     fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="miter" />
            <circle cx="32" cy="32" r="15" fill="currentColor" opacity="0.82" />
          </svg>
        </a>
        {/* 넓은 화면에서만 우산 이름을 글자로 든다 — 좁은 화면에서는 그 자리를
            **지금 어느 쪽인지**가 쓴다(맨 마크 하나보다 그것이 급하다). */}
        <span class="hidden text-[13px] font-semibold text-ink sm:inline">Radiation Lab</span>
        {/* ★ 갈 곳(칸)은 흐린 글자, **지금 있는 곳**은 진한 글자다 — 왼쪽 것을 칸과 같은
            색·무게로 두면 누를 수 있는 것처럼 읽힌다(모바일에서는 이것이 유일한 왼쪽 글자다). */}
        {barLabel
          ? <span class="min-w-0 flex-1 truncate text-[13px] text-ink"><span class="hidden text-ink-faint sm:inline">·&#8201;</span>{barLabel}</span>
          : <span class="flex-1"></span>}
        {/* 손가락 표적 24px(WCAG 2.5.8) — 13px 글자는 줄 높이가 18px 뿐이라
            세로 여백으로만 넓힌다(바 높이 45px 예산은 그대로다). */}
        <nav class="ml-auto flex items-center gap-x-3 text-[13px] [&>a]:inline-flex [&>a]:min-h-[24px] [&>a]:items-center">
          <a href={u("/")} aria-current={here === u("/") ? "page" : undefined}
             class:list={["hover:text-ink", here === u("/") ? "font-semibold text-ink" : "text-ink-muted"]}>Calculators</a>
          {SAVE_ENABLED ? <a href={u("/saved/")} class="text-ink-muted hover:text-ink">Saved</a> : null}
          <a href={u("/methods/")} class="text-ink-muted hover:text-ink">Methods</a>
        </nav>
      </div>
    </div>

    <script is:inline>
      (function () {
        var s = document.getElementById("hdr-sentinel"), b = document.getElementById("topbar");
        if (!s || !b || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(function (e) {
          b.dataset.on = e[0].isIntersecting ? "false" : "true";
        }, { threshold: 0 }).observe(s);
      })();
    </script>

    {/* ★ tabindex="-1" 이 없으면 건너뛰기 링크가 **절반만 듣는다** — 주소는 #main 으로 가고
        화면도 내려가지만 **초점은 body 에 남아**, 다음 Tab 이 다시 쪽 맨 위로 돌아간다.
        키보드 이용자에게는 링크가 아무 일도 안 한 것과 같다(2026-09-14 실측으로 잡았다). */}
    <main id="main" tabindex="-1" class="mx-auto max-w-content px-4 py-8 focus:outline-none"><slot /></main>

    <footer class="mt-16 border-t border-line bg-panel">
      <div class="mx-auto max-w-content space-y-5 px-4 py-8 text-[13px]">
        <nav class="flex flex-wrap gap-x-4 gap-y-1.5">
          {TOOLS.map((t) => <a href={u(`/${t.slug}/`)} class="text-ink-muted hover:text-ink">{t.name}</a>)}
        </nav>
        <div>
          <p class="label">Data sources</p>
          <ul class="mt-1 space-y-0.5 text-ink-muted">
            {DATA_SOURCES.map((d) => (
              <li><a href={d.url} rel="noopener" class="hover:text-ink">{d.name}</a></li>
            ))}
          </ul>
        </div>
        <p class="text-ink-faint leading-relaxed">
          {SITE_NAME} is part of {UMBRELLA_NAME}. These calculators are for orientation and
          cross-checking. They <strong>do not replace</strong> an accredited calibration, a shielding
          design, a dose assessment, or a radiation survey by a qualified person.
        </p>
        <nav class="flex flex-wrap gap-x-4 gap-y-1.5 text-ink-faint">
          <a href={u("/disclaimer/")} class="hover:text-ink">Disclaimer</a>
          <a href={u("/methods/")} class="hover:text-ink">Methods and data</a>
          {/* ★ 개인정보·약관은 **플랫폼 층**이고 오리진 루트에는 없다 —
              `/privacy/`·`/terms/` 로 걸었다가 라이브에서 404 가 났다(2026-09-14 실측).
              플랫폼 문서가 사는 자리를 그대로 가리킨다. */}
          <a href="/radimeter/privacy/" class="hover:text-ink">Privacy</a>
          <a href="/radimeter/terms/" class="hover:text-ink">Terms</a>
          <a href="/radimeter/contact/" class="hover:text-ink">Contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* 꺼져 있을 때 `visibility: hidden` 이라 **탭 순서에도 없다** — 안 보이는 링크에
     초점이 가는 사고를 막는다. 켜고 끄는 것은 data-on 한 속성이다. */
  .topbar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 40;
    transform: translateY(-100%); visibility: hidden;
    transition: transform 0.16s ease-out, visibility 0s linear 0.16s;
  }
  .topbar[data-on="true"] {
    transform: none; visibility: visible;
    transition: transform 0.16s ease-out, visibility 0s;
  }
  .topbar-mark { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; flex: none; color: rgb(var(--c-ink)); }
  .topbar-mark svg { width: 20px; height: 20px; }
  .topbar-mark:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .topbar { transition: none; } }
</style>
