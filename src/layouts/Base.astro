<style is:global>
  /* 꺼져 있을 때 `visibility: hidden` 이라 **탭 순서에도 없다** — 안 보이는 링크에
     초점이 가는 사고를 막는다. 켜고 끄는 것은 data-on 한 속성이다. */
  .topbar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 40;
    transform: translateY(-100%); visibility: hidden;
    transition: transform 0.16s ease-out, visibility 0s linear 0.16s;
  }
  .topbar[data-on="true"] {
    transform: none; visibility: visible;
    transition: transform 0.16s ease-out, visibility 0s;
  }
  /* 바 자신의 높이도 정본에서 나온다 — 아래 테두리 1px 을 뺀 값이 안쪽 높이다 */
  .topbar-in { height: calc(var(--bar-h) - 1px); }
  .topbar-mark { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; flex: none; color: rgb(var(--c-ink)); }
  .topbar-mark svg { width: 20px; height: 20px; }
  .topbar-mark:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .topbar { transition: none; } }
</style>
