---
import "../styles/global.css";
import { SITE_NAME, UMBRELLA_NAME, DATA_SOURCES, SITE_URL, u, canonical, canonicalPath } from "../lib/site";
import { TOOLS, menuName } from "../lib/tools";
import ogManifest from "../data/og-manifest.json";
import SiteHeader from "../components/brand/SiteHeader.astro";
/* ★★ 공통 셸 v3(2026-10-28) — 머리글 · 꼬리말 · head 자산은 정본 `radiation-lab/public/shell/` 의 사본(`shell/`,
 *  `npm run sync-shell`)이 그린다. 옛 `ThemeToggle` · `AccountChip` · `ShareRow` 는 걷었다 — 테마 단추와 계정 칩은
 *  머리글 출력에, 공유 줄은 꼬리말 출력에 들어 있고 동작은 `/shell/shell.js` 가 든다. */
import spec from "../../shell/shell.json";
import { renderHeadAssets, renderFooter } from "../../shell/render.mjs";
import { shareFor } from "../lib/shell-page.mjs";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** 남에게 권할 쪽이 아닌 곳(개인 저장 목록)은 끈다 — 공통 꼬리말의 공유 줄은 모든 쪽에 있으므로, 끄면 이 쪽 대신
   *  apex 홈을 권한다(`lib/shell-page.mjs`). */
  share?: boolean;
  /** ★★ **이 쪽이 무엇인지 사실대로 적는다.** 기본값은 계산기(`WebApplication`)인데,
   *  핵종 낱장(그때 147장, 2026-10-06 ④ 부터 70장)은 **계산기가 아니라 자료 낱장**이라 그대로 두면 그 쪽들이 거짓을
   *  주장하게 된다(「없는 것을 주장하지 않는다」 — 구조화 데이터를 세울 때 정한 규칙이다). */
  schema?: "WebApplication" | "TechArticle" | "CollectionPage" | "WebPage";
  /** 쪽에 **실제로 보이는** 자주 묻는 질문 — 있으면 `FAQPage` 노드를 하나 더 단다(2026-10-25 D3).
   *  ★ 본문에 그리는 것과 같은 배열을 받는다(`data/tool-faq.ts`). 화면에 없는 문답을 구조화 데이터에만 싣지 않는다. */
  faq?: readonly { q: string; a: string }[];
  /** ★ 없는 주소에 나가는 쪽(404) — 주소가 정해져 있지 않으므로 canonical·og:url·쪽 노드를 달지 않는다(2026-10-25 D5).
   *  그전에는 `/calc/404/` 를 정본이라 말해, 어느 없는 주소든 그 주소의 정본이 404 쪽이라고 주장했다. */
  notFound?: boolean;
}
const { title, description, noindex, share = true, schema = "WebApplication", faq, notFound = false } = Astro.props;
const here = Astro.url.pathname;
/** ★★ 압축 고정 바의 칸 — **머리글과 같은 글자·순서**다(명세 §1, 2026-10-06 ⑥).
 *  ★ 바에는 메뉴 판을 다시 싣지 않는다 — 같은 일곱 링크가 쪽마다 두 벌 서면 쪽 사이 겹침만 는다.
 *    바의 `Calculators` 는 홈의 계산기 묶음(`/#tools`)으로, `Pro workbenches` 는 홈의 워크벤치 묶음(`/#workbenches`)으로 간다.
 *  ★ 2026-10-27(감독 지시 31) — 머리글 메뉴가 둘(Calculators · Pro workbenches)이 되어 바의 칸도 다섯이다. 좁은 폭은 Calc · Pro.
 *  ★ 2026-10-27(지시 32 보충) — 머리글과 같이 Pro workbenches 가 앞이다(워크벤치가 대표, 계산기는 가벼운 동반 도구). */
const NAVI = [
  { href: "/#workbenches", label: "Pro workbenches", short: "Pro", on: false },
  { href: "/#tools", label: "Calculators", short: "Calc", on: false },
  { href: "/calc/nuclides/", label: "Nuclide data", short: "Nuclides", on: here.startsWith("/calc/nuclides/") },
  { href: "/calc/methods/", label: "Methods", short: "Methods", on: here.startsWith("/calc/methods/") },
  { href: "/calc/validation/", label: "Validation", short: "Validation", on: here.startsWith("/calc/validation/") },
];
const navCls = (on: boolean) =>
  [
    "rounded border px-2 py-1.5 transition-colors whitespace-nowrap sm:px-3",
    on ? "border-line-strong bg-surface text-ink font-semibold"
       : "border-transparent text-ink-muted hover:bg-surface hover:text-ink",
  ].join(" ");
const full = `${title} · ${SITE_NAME}`;
/* 압축 바가 드는 「지금 어디」 — 쪽마다 적게 하지 않는다(쪽 제목에서 파생한다). */
const barLabel = title;
/* ★★ 공유 그림 — **커밋된 산출물**이고 `scripts/make-og.mjs` 가 굽는다.
   ★ 조회는 반드시 `canonicalPath()`(base 없음)로 한다 — base 가 붙은 pathname 으로 찾으면
     매니페스트와 안 맞아 **전 쪽이 조용히 폴백으로 떨어진다**(이웃 lab 이 밟은 함정).
   ★ 사이트맵에 없는 쪽(noindex 인 `/saved/`)은 그림이 없으므로 홈 카드로 받는다. */
const OG = ogManifest as Record<string, { slug: string }>;
/* ★ 2026-10-06 ⑥ — 사이트맵 밖 쪽의 대체 카드는 매니페스트 `"*"` 칸이다(`/` 허브가 걷혔다). */
const ogSlug = OG[canonicalPath(here)]?.slug ?? OG["*"]?.slug ?? "home";
const ogImage = new URL(u(`/og/${ogSlug}.png`), SITE_URL).href;
/* 세션 표식을 그리기 전에 세우려면 부팅 스크립트가 저장소 칸 이름을 알아야 한다.
   ★ 이름을 글자로 박지 않고 **환경변수에서 뽑는다** — 프로젝트가 바뀌면 저절로 따라온다. */
const SB_REF = (import.meta.env.VITE_SUPABASE_URL ?? "").match(/^https:\/\/([a-z0-9]+)\.supabase\.co/)?.[1] ?? "";
/* 공통 셸 — head 자산(/shell/shell.css?v=N · /shell/shell.js?v=N + 그리기 전 테마 스크립트)과 꼬리말.
   ★ `apex: true` — 같은 오리진의 루트 상대 주소다(제3자 요청 0). 라이브에서는 우산 Worker 가 `/shell/*` 을 내주고,
     게이트의 로컬 서버는 `gate/shell-assets.mjs` 가 vendored 사본으로 흉내 낸다(`/track.js` 와 같은 처방).
   ★ 꼬리말이 권하는 주소는 이 쪽의 canonical 이고, 404(주소가 없다) · `share={false}`(개인 화면)는 apex 홈이다. */
const headAssets = renderHeadAssets(spec, { apex: true, withThemeBoot: true });
const shareOf = shareFor({ canonicalUrl: notFound ? undefined : canonical(here), title, share }, SITE_URL);
const footerHtml = renderFooter(spec, { section: "calc", pageUrl: shareOf.pageUrl, shareText: shareOf.shareText, apex: true });
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    {!notFound && <link rel="canonical" href={canonical(here)} />}
    {/* ★★ 색인되는 쪽에는 `max-image-preview:large` 를 준다(2026-09-17). 구글이 이 지시가
        **없을 때 쓰는 기본값은 「기본 크기」 미리보기**이고, `large` 가 더 큰 것을 **허락하는
        옵트인**이다. **허락일 뿐 보장이 아니다** — 어떤 그림을 쓸지는 구글이 정한다.
        그전에는 우산 루트에만 있었고 이 lab 에는 **robots meta 가 아예 없었다** — 같은
        오리진 안에서 층마다 다른 말을 하고 있었던 셈이다(정본 `radiation-lab` README).
        ★ `noindex` 인 쪽에는 주지 않는다 — 색인하지 말라고 한 쪽에 미리보기 크기를 말하는
        것은 뜻이 없고, 섞여 있으면 둘 중 하나가 실수라는 신호다. */}
    {noindex
      ? <meta name="robots" content="noindex,follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!notFound && <meta property="og:url" content={canonical(here)} />}
    <meta property="og:site_name" content={UMBRELLA_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {/* ★★ 공통 셸의 head 자산 — **그리기 전 테마 스크립트** + `/shell/shell.css?v=N` + `/shell/shell.js?v=N`(defer).
        테마 스크립트는 우산 쪽과 같은 것(`withThemeBoot`)이다: 저장된 선택이 없으면 OS 설정을 읽어 `data-theme` 을 **항상**
        세운다. 그전 이 자리의 스크립트는 저장된 선택이 있을 때만 세웠는데, shell.js 의 단추(`#thm`)와 해·달 그림은
        `data-theme` 만 보므로 — OS 가 다크인 사람에게 해가 보이고 첫 클릭이 「다크 → 다크」가 되는 어긋남이 있었다.
        ★ JS 로 글자를 넣으면 첫 그림에 반대 상태가 보인다 — 그래서 CSS 가 그리고 스크립트는 속성 하나만 세운다(그대로). */}
    <Fragment set:html={headAssets} />
    {/* ★★ 계정 상태도 **그리기 전에** 세운다 — 로그인한 사람이 첫 그림에 「Sign in」을 보면
        안 된다. 같은 오리진의 localStorage 한 칸을 읽을 뿐이라 **요청이 0건**이고, 동의
        배너 이전에 나가는 제3자 호출도 없다. 세 lab 과 우산이 같은 칸을 읽는다. */}
    {SB_REF && (
      <script is:inline define:vars={{ SB_REF }}>
        try {
          var raw = localStorage.getItem("sb-" + SB_REF + "-auth-token");
          if (raw) {
            if (raw.slice(0, 7) === "base64-") raw = atob(raw.slice(7));
            var s = JSON.parse(raw);
            var live = !(s && s.expires_at && s.expires_at * 1000 < Date.now());
            if (live && s && s.user) {
              document.documentElement.dataset.acct = "in";
              var m = "";
              try { m = localStorage.getItem("rl-profile-name") || ""; } catch (e) { m = ""; }
              var md = s.user.user_metadata || {};
              document.documentElement.dataset.acctWho = m || md.name || md.full_name || s.user.email || "";
            }
          }
        } catch (e) {}
      </script>
    )}

    {/* 플랫폼 방문 집계 — **스크립트 본체는 이 레포에 없다.**
        ★★ 정본은 우산 저장소의 `public/track.js` 한 벌이고 lab 넷이 **같은 파일**을 읽는다.
        lab 마다 복제하면 한쪽만 고쳐진다.
        ★ **`base` 를 붙이지 않는다** — 오리진 루트의 파일이고 플랫폼 층(우산)이 내준다.
        base 를 붙이면 `/calc/track.js` 가 되어 404 가 나고 집계만 조용히 죽는다.
        그래서 `is:inline` 으로 Astro 가 손대지 못하게 둔다.
        ★ 쿠키·localStorage 를 쓰지 않으므로 동의 대상이 아니다(스키마 `sql/visits.sql`). */}
    <script is:inline src="/track.js" data-lab="calc" defer></script>
  {/* 구조화 데이터 — 2026-09-16 라이브 감사에서 **이 lab 10쪽에 0개**였다
      (RadiMeter 는 34쪽이 들고 있다). 검색이 「이게 무엇인지」를 읽는 자리다.
      ★ **없는 것을 주장하지 않는다** — 평점·리뷰·가격은 넣지 않는다(우리에게 없다).
        무료라는 것만 `isAccessibleForFree` 로 사실대로 적는다.
      ★ 주소는 `canonical()`·`SITE_URL` 에서 파생시킨다 — 글자로 박지 않는다
        (`npm run check-address` 가 지킨다). */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        /* ★ 2026-10-06 ⑥ — `/calc/` 허브가 걷혀 사이트는 apex 하나다. 우산 홈의 WebSite 노드와 같은 @id 다. */
        "@id": `${new URL("/", SITE_URL).href}#site`,
        name: SITE_NAME,
        url: new URL("/", SITE_URL).href,
        inLanguage: "en",
      },
      ...(notFound ? [] : [schema === "WebApplication"
        ? {
            "@type": "WebApplication",
            "@id": `${canonical(here)}#app`,
            name: title,
            url: canonical(here),
            applicationCategory: "ScienceApplication",
            operatingSystem: "Any (web browser)",
            inLanguage: "en",
            isAccessibleForFree: true,
            description,
          }
        : {
            "@type": schema,
            "@id": `${canonical(here)}#page`,
            name: title,
            headline: title,
            url: canonical(here),
            inLanguage: "en",
            isAccessibleForFree: true,
            description,
            /* 자료의 출처를 기계가 읽을 수 있게 단다 — 값이 우리 것이 아니라 IAEA·NIST 의 것이다.
               ★ `WebPage`(면책 등 안내 쪽)에는 달지 않는다 — 그 쪽은 그 자료로 쓴 글이 아니다. */
            ...(schema === "WebPage" ? {} : { citation: DATA_SOURCES.map((d) => d.name) }),
          }]),
      /* ★ 쪽의 주 노드(`#app`·`#page`)를 바꾸지 않고 **곁에** 선다 — 계산기는 계산기, 문답은 문답이다. */
      ...(faq?.length
        ? [{
            "@type": "FAQPage",
            "@id": `${canonical(here)}#faq`,
            url: canonical(here),
            inLanguage: "en",
            mainEntity: faq.map((f) => ({
              "@type": "Question",
              name: f.q,
              acceptedAnswer: { "@type": "Answer", text: f.a },
            })),
          }]
        : []),
    ],
  })} />
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>

    {/* ★★ **머리글은 한 줄이다**(2026-10-06 ⑥ — 소유주 「상단에 놓아두는 2가지 영역이 다르네… 하나의 계산기 안에
        다양한 도구가 들어있는 형태로」). 2026-10-28 부터 그 한 줄은 **공통 셸 v3**(정본 `radiation-lab/public/shell/`,
        HEADER-SPEC v3)의 render.mjs 출력이다 — 우산 홈과 글자 그대로 같은 막대. 전환 손잡이(`#thm`)와 계정 칩(`#acct`)은
        그 출력 안에 있다. */}
    <SiteHeader here={here} />

    {/* ★★ **압축 고정 바** — 진짜 머리글은 흘려보내고, **지나친 뒤에만** 45px 바가 뜬다.
        머리글 전체를 고정하면 세로 공간을 영구히 뺏는다 — 2026-10-06 두 막대가 된 뒤로는 더하다
        (실측 1280px 89px · 390px 148px = 모바일 844px 의 17.5%). 바는 그대로 **lab 칸**을 든다(명세 —
        플랫폼 칸은 맨 위에 돌아가면 있다).
        · 센티넬 + IntersectionObserver 다 — `fixed` 는 흐름에서 자리를 안 먹으므로
          CSS 만으로는 「지나쳤는가」를 알 수 없다.
        · **JS 가 없으면 아무 일도 일어나지 않는다**(`visibility: hidden` 이 기본, 회귀 0).
        · 마크가 가리키는 곳은 플랫폼 막대의 브랜드와 **같다**(우산 `/`) — 같은 글리프가 자리마다
          다른 곳으로 가면 읽는 사람이 둘을 다른 것으로 배운다.
        · 바가 생기는 순간 **`scroll-padding-top` 이 필요하다**(global.css 72px).
          없으면 앵커를 눌렀을 때 제목이 바 높이만큼 정확히 가린다. */}
    <div id="hdr-sentinel" aria-hidden="true" class="h-px"></div>

    <div id="topbar" data-on="false" class="topbar border-b border-line-strong bg-panel">
      <div class="topbar-in mx-auto flex max-w-content items-center gap-3 px-5 sm:px-8">
        <a href="https://radiation-lab.com/" class="topbar-mark" aria-label="Radiation Lab — home">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <polygon points="32.00,6.20 50.24,13.76 57.80,32.00 50.24,50.24 32.00,57.80 13.76,50.24 6.20,32.00 13.76,13.76"
                     fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="miter" />
            <circle cx="32" cy="32" r="15" fill="currentColor" opacity="0.82" />
          </svg>
        </a>
        {/* 넓은 화면에서만 우산 이름을 글자로 든다 — 좁은 화면에서는 그 자리를
            **지금 어느 쪽인지**가 쓴다(맨 마크 하나보다 그것이 급하다). */}
        <span class="hidden text-[13px] font-semibold text-ink sm:inline">Radiation Lab</span>
        {/* ★ 갈 곳(칸)은 흐린 글자, **지금 있는 곳**은 진한 글자다 — 왼쪽 것을 칸과 같은
            색·무게로 두면 누를 수 있는 것처럼 읽힌다(모바일에서는 이것이 유일한 왼쪽 글자다). */}
        {barLabel
          ? <span class="min-w-0 flex-1 truncate text-[13px] text-ink"><span class="hidden text-ink-faint sm:inline">·&#8201;</span>{barLabel}</span>
          : <span class="flex-1"></span>}
        {/* 손가락 표적 24px(WCAG 2.5.8) — 13px 글자는 줄 높이가 18px 뿐이라
            세로 여백으로만 넓힌다(바 높이 45px 예산은 그대로다). */}
        <nav aria-label="Primary (compact)" class="ml-auto flex shrink-0 items-center gap-0.5 text-[13px] sm:gap-1">
          {NAVI.map((n) => (
            <a href={n.href} title={n.label} aria-current={n.on ? "page" : undefined} class={navCls(n.on)}><span class="hidden sm:inline">{n.label}</span><span class="sm:hidden">{n.short}</span></a>
          ))}
        </nav>
      </div>
    </div>

    <script is:inline>
      (function () {
        var s = document.getElementById("hdr-sentinel"), b = document.getElementById("topbar");
        if (!s || !b || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(function (e) {
          b.dataset.on = e[0].isIntersecting ? "false" : "true";
        }, { threshold: 0 }).observe(s);
      })();
    </script>

    {/* ★ tabindex="-1" 이 없으면 건너뛰기 링크가 **절반만 듣는다** — 주소는 #main 으로 가고
        화면도 내려가지만 **초점은 body 에 남아**, 다음 Tab 이 다시 쪽 맨 위로 돌아간다.
        키보드 이용자에게는 링크가 아무 일도 안 한 것과 같다(2026-09-14 실측으로 잡았다). */}
    {/* ★ 공유 줄은 읽고 난 뒤에 권한다 — 2026-10-28 부터 공통 꼬리말의 첫 줄이다(`ShareRow.astro` 는 걷었다 — 같은 다섯
        단추가 본문 끝과 꼬리말에 두 벌 서면 안 된다). 개인 화면(`share={false}`)은 이 쪽 대신 apex 홈을 권한다. */}
    <main id="main" tabindex="-1" class="mx-auto max-w-content px-5 py-8 focus:outline-none sm:px-8">
      <slot />
    </main>

    {/* ★★ 공통 꼬리말(v3)에는 이 lab 의 **도구 여덟 · 자료 출처 · 면책 문단**이 없다(공유 줄 · 3열 · 한 줄 — 네 오리진 동일).
        그 셋은 쪽마다 있어야 하는 것들이라(check-output ⑦ 「면책 · IAEA/NIST 출처가 모든 쪽에」, 도구 링크 여덟은
        내부 링크 수의 일부) 꼬리말 **위의 aside** 로 옮겨 보존한다. `<main>` 밖이다 — 안에 두면 쪽마다 어수가 늘어
        얇은 쪽 검사(check-output ⑥ · check-adsense ②)가 둔해진다. 도구 링크는 `<nav>` 라 check-notes 가 세지 않는다.
        옛 꼬리말의 「Platform documents」(Disclaimer · Methods · Validation · About · Privacy · Terms · Contact)는 공통
        꼬리말의 About the site · Legal 열이 전부 든다 — 잃은 링크 0. */}
    <aside class="site-notes mx-auto max-w-content px-5 pb-10 pt-2 text-[13px] sm:px-8" aria-label="Calculators, data sources and scope">
      <nav aria-label="All calculators" class="flex flex-wrap gap-x-4 gap-y-1.5">
        {TOOLS.map((t) => <a href={u(`/${t.slug}/`)} class="text-ink-muted hover:text-ink">{menuName(t)}</a>)}
      </nav>
      <div class="mt-5">
        <p class="label">Data sources</p>
        <ul class="mt-1 space-y-0.5 text-ink-muted">
          {DATA_SOURCES.map((d) => (
            <li><a href={d.url} rel="noopener" class="hover:text-ink">{d.name}</a></li>
          ))}
        </ul>
      </div>
      <p class="mt-5 text-ink-faint leading-relaxed">
        {UMBRELLA_NAME}'s calculators are for orientation and
        cross-checking. They <strong>do not replace</strong> an accredited calibration, a shielding
        design, a dose assessment, or a radiation survey by a qualified person.
      </p>
    </aside>

    {/* ★★ 공통 꼬리말 — render.mjs 출력 그대로(공유 줄 · About the site / Radiation Lab / Legal · 한 줄).
        ★★ 개인정보·약관·연락·About 은 **플랫폼 층**이고 우산 루트에 산다(`/privacy` · `/terms` · `/contact` · `/about`,
          끝 슬래시 없음 — 우산의 canonical 이 그렇다; 2026-09-28 · 2026-10-25 라이브 200 확인). 그 주소는 이제 shell.json 이
          들고 render.mjs 가 apex 에서 루트 상대로 낸다 — 이 레포가 글자로 적지 않는다(check-output ② 의 허용 목록은 그대로다).
        ★ `gate/check-shell.mjs` 가 산출물의 footer.site 를 같은 호출로 다시 그려 바이트 동일을 잰다. */}
    <Fragment set:html={footerHtml} />
  </body>
</html>

<style is:global>
  /* 꺼져 있을 때 `visibility: hidden` 이라 **탭 순서에도 없다** — 안 보이는 링크에
     초점이 가는 사고를 막는다. 켜고 끄는 것은 data-on 한 속성이다. */
  .topbar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 40;
    transform: translateY(-100%); visibility: hidden;
    transition: transform 0.16s ease-out, visibility 0s linear 0.16s;
  }
  .topbar[data-on="true"] {
    transform: none; visibility: visible;
    transition: transform 0.16s ease-out, visibility 0s;
  }
  /* 바 자신의 높이도 정본에서 나온다 — 아래 테두리 1px 을 뺀 값이 안쪽 높이다 */
  .topbar-in { height: calc(var(--bar-h) - 1px); }
  .topbar-mark { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; flex: none; color: rgb(var(--c-ink)); }
  .topbar-mark svg { width: 20px; height: 20px; }
  .topbar-mark:focus-visible { outline: 2px solid rgb(var(--c-accent)); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) { .topbar { transition: none; } }
</style>
