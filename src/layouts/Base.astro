---
import "../styles/global.css";
import { SITE_NAME, SITE_TAGLINE, UMBRELLA_NAME, DATA_SOURCES, SITE_URL, u, canonical, canonicalPath } from "../lib/site";
import { TOOLS } from "../lib/tools";
import { SAVE_ENABLED } from "../lib/features";
import ogManifest from "../data/og-manifest.json";
import Lockup from "../components/brand/Lockup.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import AccountChip from "../components/AccountChip.astro";
import ShareRow from "../components/ShareRow.astro";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** 남에게 권할 쪽이 아닌 곳(개인 저장 목록)은 끈다 */
  share?: boolean;
  /** ★★ **이 쪽이 무엇인지 사실대로 적는다.** 기본값은 계산기(`WebApplication`)인데,
   *  핵종 낱장 147장은 **계산기가 아니라 자료 낱장**이라 그대로 두면 147쪽이 거짓을
   *  주장하게 된다(「없는 것을 주장하지 않는다」 — 구조화 데이터를 세울 때 정한 규칙이다). */
  schema?: "WebApplication" | "TechArticle" | "CollectionPage";
}
const { title, description, noindex, share = true, schema = "WebApplication" } = Astro.props;
const here = Astro.url.pathname;
/** ★★ **머리글과 압축 고정 바가 같은 목록을 읽는다**(2026-09-16). 그전에는 링크 세 줄이
 *  두 곳에 복사돼 있었고, 그 바람에 **`Saved`·`Methods` 에는 활성 표시가 아예 없었다** —
 *  `/methods/` 에서 켜지는 칸이 0개라 「지금 어디」가 사라졌다. 목록을 한 곳에 두면
 *  칸을 늘릴 때 한쪽만 고쳐지는 사고가 구조적으로 없다. */
const NAVI = [
  { href: "/", label: "Calculators" },
  /* ★ 핵종 낱장 147장으로 가는 문. 도구는 「무엇을 계산하는가」로 찾고, 여기는
     「어느 핵종인가」로 찾는다 — 찾아오는 이유가 다르므로 칸을 따로 준다. */
  { href: "/nuclides/", label: "Nuclides" },
  ...(SAVE_ENABLED ? [{ href: "/saved/", label: "Saved" }] : []),
  { href: "/methods/", label: "Methods" },
];
const navOn = (href: string) => (href === "/" ? here === u("/") : here.startsWith(u(href)));
/** ★ 칸 모양은 **플랫폼 셋이 같다**(2026-09-16 소유주 지시 「상단메뉴는 동일한 배경,
 *  폰트, 크기를 사용하면 좋겠어」) — 13px · 흐린 글자 · 활성은 앰버 알약.
 *  ★ 비활성에도 **투명 테두리**를 준다. 없으면 활성 칸만 1px 씩 커져 줄이 흔들린다. */
const navCls = (href: string) =>
  [
    /* ★ 모서리 4px · 안여백 6/12px 은 **RadiMeter 의 칸과 같은 치수**다(실측으로 맞췄다).
       `rounded-lg` 는 이 lab 에서 8px, RadiMeter 의 디자인 체계에서는 4px 이라
       **같은 클래스 이름이 두 배 다른 값**으로 풀린다 — 이름이 아니라 값을 맞춘다. */
    "rounded border px-3 py-1.5 transition-colors whitespace-nowrap",
    navOn(href)
      ? "bg-accent-soft text-accent font-semibold border-accent/25"
      : "border-transparent text-ink-muted hover:bg-surface hover:text-ink",
  ].join(" ");
const full = `${title} · ${SITE_NAME}`;
/* 압축 바가 드는 「지금 어디」 — 쪽마다 적게 하지 않는다(쪽 제목에서 파생한다).
   ★ 허브에서는 비운다 — 칸 「Calculators」 가 이미 켜져 있어 같은 말이 두 번 나온다. */
const barLabel = here === u("/") ? "" : title;
/* ★★ 공유 그림 — **커밋된 산출물**이고 `scripts/make-og.mjs` 가 굽는다.
   ★ 조회는 반드시 `canonicalPath()`(base 없음)로 한다 — base 가 붙은 pathname 으로 찾으면
     매니페스트와 안 맞아 **전 쪽이 조용히 폴백으로 떨어진다**(이웃 lab 이 밟은 함정).
   ★ 사이트맵에 없는 쪽(noindex 인 `/saved/`)은 그림이 없으므로 홈 카드로 받는다. */
const ogSlug = (ogManifest as Record<string, { slug: string }>)[canonicalPath(here)]?.slug ?? "home";
const ogImage = new URL(u(`/og/${ogSlug}.png`), SITE_URL).href;
/* 세션 표식을 그리기 전에 세우려면 부팅 스크립트가 저장소 칸 이름을 알아야 한다.
   ★ 이름을 글자로 박지 않고 **환경변수에서 뽑는다** — 프로젝트가 바뀌면 저절로 따라온다. */
const SB_REF = (import.meta.env.VITE_SUPABASE_URL ?? "").match(/^https:\/\/([a-z0-9]+)\.supabase\.co/)?.[1] ?? "";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={canonical(here)} />
    {/* ★★ 색인되는 쪽에는 `max-image-preview:large` 를 준다(2026-09-17). 구글이 이 지시가
        **없을 때 쓰는 기본값은 「기본 크기」 미리보기**이고, `large` 가 더 큰 것을 **허락하는
        옵트인**이다. **허락일 뿐 보장이 아니다** — 어떤 그림을 쓸지는 구글이 정한다.
        그전에는 우산 루트에만 있었고 이 lab 에는 **robots meta 가 아예 없었다** — 같은
        오리진 안에서 층마다 다른 말을 하고 있었던 셈이다(정본 `radiation-lab` README).
        ★ `noindex` 인 쪽에는 주지 않는다 — 색인하지 말라고 한 쪽에 미리보기 크기를 말하는
        것은 뜻이 없고, 섞여 있으면 둘 중 하나가 실수라는 신호다. */}
    {noindex
      ? <meta name="robots" content="noindex,follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical(here)} />
    <meta property="og:site_name" content={UMBRELLA_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {/* 그리기 전에 테마를 적용한다 — JS 로 글자를 넣으면 첫 그림에 반대 상태가 보인다 */}
    <script is:inline>
      try {
        const s = JSON.parse(localStorage.getItem("radmeter-v2-theme") || "null");
        const m = s && s.state && s.state.mode;
        if (m === "dark" || m === "light") document.documentElement.dataset.theme = m;
      } catch (e) {}
    </script>
    {/* ★★ 계정 상태도 **그리기 전에** 세운다 — 로그인한 사람이 첫 그림에 「Sign in」을 보면
        안 된다. 같은 오리진의 localStorage 한 칸을 읽을 뿐이라 **요청이 0건**이고, 동의
        배너 이전에 나가는 제3자 호출도 없다. 세 lab 과 우산이 같은 칸을 읽는다. */}
    {SB_REF && (
      <script is:inline define:vars={{ SB_REF }}>
        try {
          var raw = localStorage.getItem("sb-" + SB_REF + "-auth-token");
          if (raw) {
            if (raw.slice(0, 7) === "base64-") raw = atob(raw.slice(7));
            var s = JSON.parse(raw);
            var live = !(s && s.expires_at && s.expires_at * 1000 < Date.now());
            if (live && s && s.user) {
              document.documentElement.dataset.acct = "in";
              var m = "";
              try { m = localStorage.getItem("rl-profile-name") || ""; } catch (e) { m = ""; }
              var md = s.user.user_metadata || {};
              document.documentElement.dataset.acctWho = m || md.name || md.full_name || s.user.email || "";
            }
          }
        } catch (e) {}
      </script>
    )}

    {/* 플랫폼 방문 집계 — **스크립트 본체는 이 레포에 없다.**
        ★★ 정본은 우산 저장소의 `public/track.js` 한 벌이고 lab 넷이 **같은 파일**을 읽는다.
        lab 마다 복제하면 한쪽만 고쳐진다.
        ★ **`base` 를 붙이지 않는다** — 오리진 루트의 파일이고 플랫폼 층(우산)이 내준다.
        base 를 붙이면 `/calc/track.js` 가 되어 404 가 나고 집계만 조용히 죽는다.
        그래서 `is:inline` 으로 Astro 가 손대지 못하게 둔다.
        ★ 쿠키·localStorage 를 쓰지 않으므로 동의 대상이 아니다(스키마 `sql/visits.sql`). */}
    <script is:inline src="/track.js" data-lab="calc" defer></script>
  {/* 구조화 데이터 — 2026-09-16 라이브 감사에서 **이 lab 10쪽에 0개**였다
      (RadiMeter 는 34쪽이 들고 있다). 검색이 「이게 무엇인지」를 읽는 자리다.
      ★ **없는 것을 주장하지 않는다** — 평점·리뷰·가격은 넣지 않는다(우리에게 없다).
        무료라는 것만 `isAccessibleForFree` 로 사실대로 적는다.
      ★ 주소는 `canonical()`·`SITE_URL` 에서 파생시킨다 — 글자로 박지 않는다
        (`npm run check-address` 가 지킨다). */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": `${new URL(u("/"), SITE_URL).href}#website`,
        name: SITE_NAME,
        url: new URL(u("/"), SITE_URL).href,
        inLanguage: "en",
        isPartOf: { "@type": "WebSite", name: UMBRELLA_NAME, url: new URL(SITE_URL).origin },
      },
      schema === "WebApplication"
        ? {
            "@type": "WebApplication",
            "@id": `${canonical(here)}#app`,
            name: title,
            url: canonical(here),
            applicationCategory: "ScienceApplication",
            operatingSystem: "Any (web browser)",
            inLanguage: "en",
            isAccessibleForFree: true,
            description,
          }
        : {
            "@type": schema,
            "@id": `${canonical(here)}#page`,
            name: title,
            headline: title,
            url: canonical(here),
            inLanguage: "en",
            isAccessibleForFree: true,
            description,
            /* 자료의 출처를 기계가 읽을 수 있게 단다 — 값이 우리 것이 아니라 IAEA·NIST 의 것이다. */
            citation: DATA_SOURCES.map((d) => d.name),
          },
    ],
  })} />
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>

    <header class="border-b border-line-strong bg-panel">
      <div class="mx-auto flex max-w-content flex-wrap items-center gap-x-2 gap-y-2 px-5 py-2 sm:px-8 sm:py-3 sm:gap-x-4">
        <Lockup labName={SITE_NAME} labHref={u("/")} />
        {/* ★ 다른 lab 으로 가는 칸을 두지 않는다(2026-09-14 소유주 지적
            「radcalc 페이지 메뉴에만 왜 radimeter 연결 탭이 있어?」).
            **lab 을 고르는 자리는 우산이다** — 잠금장치가 그리로 보낸다.
            여기에 두면 ① 다른 두 lab 에는 없어 불균형이고 ② lab 이 늘 때마다
            세 머리글을 다 고쳐야 하며 ③ 잠금장치와 같은 말을 두 번 한다. */}
        {/* ★ **도구 목록으로 돌아가는 칸이 없었다**(2026-09-14 소유주 지적
            「radcalc 상단 메뉴에 다시 첫 계산도구 선택하는 화면으로 못 돌아가잖아」).
            허브로 가는 길이 로고 글자와 빵부스러기 둘뿐이었는데 **둘 다 눈에 안 띄는 자리**다.
            도구를 고르는 것은 이 lab 에서 가장 자주 하는 이동이므로 첫 칸을 준다. */}
        {/* ★★ 좁은 화면에서는 **칸이 제 줄을 쓴다**(2026-09-15 실측으로 정했다). 그전에는
            잠금장치·칸·컨트롤 셋이 한 줄에 다 못 들어가 **줄이 셋**이 됐고 360px 에서 머리글이
            148px 이었다(잠금장치 144 + 칸 185 = 329 > 가용 328 — **1px 차이로** 접혔다).
            위 줄에 잠금장치와 컨트롤(288px)을 두면 320px 에서도 두 줄이고, 브랜드 왼쪽 ·
            컨트롤 오른쪽이라 우산·RadiMeter 와 같은 배치가 된다. */}
        <nav class="order-last w-full flex flex-wrap items-center gap-0.5 text-[13px] sm:order-none sm:ml-auto sm:w-auto sm:gap-1">
          {NAVI.map((n) => (
            <a href={u(n.href)} aria-current={navOn(n.href) ? "page" : undefined} class={navCls(n.href)}>{n.label}</a>
          ))}
        </nav>
        {/* ★ 전환 손잡이와 계정 표시는 **세 lab 이 같은 자리에 같은 모양으로** 둔다
            (2026-09-15 소유주 지시 「이것처럼 로그인 상태창과 라이트·다크 전환 버튼 함께
            만들어 놓자. 동일하게」). 그전에는 이 lab 만 둘 다 없었다 — 테마는 저장된 값을
            **읽기만** 했고(바꿀 손잡이가 없었다), 계정은 로그인 여부조차 알 수 없었다. */}
        <div class="ml-auto flex shrink-0 items-center gap-1 sm:ml-0">
          <ThemeToggle compactOnMobile />
          <AccountChip />
        </div>
      </div>
    </header>

    {/* ★★ **압축 고정 바** — 진짜 머리글(72px)은 흘려보내고, **지나친 뒤에만** 45px 바가 뜬다.
        머리글 전체를 고정하면 세로 공간을 영구히 뺏는다(모바일 844px 의 8.5%).
        · 센티넬 + IntersectionObserver 다 — `fixed` 는 흐름에서 자리를 안 먹으므로
          CSS 만으로는 「지나쳤는가」를 알 수 없다.
        · **JS 가 없으면 아무 일도 일어나지 않는다**(`visibility: hidden` 이 기본, 회귀 0).
        · 마크가 가리키는 곳은 잠금장치와 **같다**(우산 `/`) — 같은 글리프가 자리마다
          다른 곳으로 가면 읽는 사람이 둘을 다른 것으로 배운다.
        · 바가 생기는 순간 **`scroll-padding-top` 이 필요하다**(global.css 72px).
          없으면 앵커를 눌렀을 때 제목이 바 높이만큼 정확히 가린다. */}
    <div id="hdr-sentinel" aria-hidden="true" class="h-px"></div>

    <div id="topbar" data-on="false" class="topbar border-b border-line-strong bg-panel">
      <div class="topbar-in mx-auto flex max-w-content items-center gap-3 px-5 sm:px-8">
        <a href="/" class="topbar-mark" aria-label="Radiation Lab — platform home">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <polygon points="32.00,6.20 50.24,13.76 57.80,32.00 50.24,50.24 32.00,57.80 13.76,50.24 6.20,32.00 13.76,13.76"
                     fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="miter" />
            <circle cx="32" cy="32" r="15" fill="currentColor" opacity="0.82" />
          </svg>
        </a>
        {/* 넓은 화면에서만 우산 이름을 글자로 든다 — 좁은 화면에서는 그 자리를
            **지금 어느 쪽인지**가 쓴다(맨 마크 하나보다 그것이 급하다). */}
        <span class="hidden text-[13px] font-semibold text-ink sm:inline">Radiation Lab</span>
        {/* ★ 갈 곳(칸)은 흐린 글자, **지금 있는 곳**은 진한 글자다 — 왼쪽 것을 칸과 같은
            색·무게로 두면 누를 수 있는 것처럼 읽힌다(모바일에서는 이것이 유일한 왼쪽 글자다). */}
        {barLabel
          ? <span class="min-w-0 flex-1 truncate text-[13px] text-ink"><span class="hidden text-ink-faint sm:inline">·&#8201;</span>{barLabel}</span>
          : <span class="flex-1"></span>}
        {/* 손가락 표적 24px(WCAG 2.5.8) — 13px 글자는 줄 높이가 18px 뿐이라
            세로 여백으로만 넓힌다(바 높이 45px 예산은 그대로다). */}
        <nav class="ml-auto flex items-center gap-1 text-[13px]">
          {NAVI.map((n) => (
            <a href={u(n.href)} aria-current={navOn(n.href) ? "page" : undefined} class={navCls(n.href)}>{n.label}</a>
          ))}
        </nav>
      </div>
    </div>

    <script is:inline>
      (function () {
        var s = document.getElementById("hdr-sentinel"), b = document.getElementById("topbar");
        if (!s || !b || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(function (e) {
          b.dataset.on = e[0].isIntersecting ? "false" : "true";
        }, { threshold: 0 }).observe(s);
      })();
    </script>

    {/* ★ tabindex="-1" 이 없으면 건너뛰기 링크가 **절반만 듣는다** — 주소는 #main 으로 가고
        화면도 내려가지만 **초점은 body 에 남아**, 다음 Tab 이 다시 쪽 맨 위로 돌아간다.
        키보드 이용자에게는 링크가 아무 일도 안 한 것과 같다(2026-09-14 실측으로 잡았다). */}
    {/* ★ 공유 줄은 본문 끝에 둔다 — 읽고 난 뒤에 권하는 것이지 읽기 전에 권하는 것이 아니다.
        저장 목록처럼 **개인 화면**에는 두지 않는다(남에게 권할 쪽이 아니다). */}
    <main id="main" tabindex="-1" class="mx-auto max-w-content px-5 py-8 focus:outline-none sm:px-8">
      <slot />
      {share ? <ShareRow title={title} /> : null}
    </main>

    <footer class="mt-16 border-t border-line-strong bg-panel">
      <div class="mx-auto max-w-content space-y-5 px-5 py-8 text-[13px] sm:px-8">
        <nav class="flex flex-wrap gap-x-4 gap-y-1.5">
