---
import "../styles/global.css";
import { SITE_NAME, SITE_TAGLINE, UMBRELLA_NAME, DATA_SOURCES, u, canonical } from "../lib/site";
import { TOOLS } from "../lib/tools";
import Lockup from "../components/brand/Lockup.astro";
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
const here = Astro.url.pathname;
const full = `${title} · ${SITE_NAME}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={canonical(here)} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : null}
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical(here)} />
    {/* 그리기 전에 테마를 적용한다 — JS 로 글자를 넣으면 첫 그림에 반대 상태가 보인다 */}
    <script is:inline>
      try {
        const s = JSON.parse(localStorage.getItem("radmeter-v2-theme") || "null");
        const m = s && s.state && s.state.mode;
        if (m === "dark" || m === "light") document.documentElement.dataset.theme = m;
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-panel focus:px-3 focus:py-2">Skip to content</a>

    <header class="border-b border-line bg-panel">
      <div class="mx-auto flex max-w-content flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <Lockup labName={SITE_NAME} labHref={u("/")} />
        {/* ★ 다른 lab 으로 가는 칸을 두지 않는다(2026-09-14 소유주 지적
            「radcalc 페이지 메뉴에만 왜 radimeter 연결 탭이 있어?」).
            **lab 을 고르는 자리는 우산이다** — 잠금장치가 그리로 보낸다.
            여기에 두면 ① 다른 두 lab 에는 없어 불균형이고 ② lab 이 늘 때마다
            세 머리글을 다 고쳐야 하며 ③ 잠금장치와 같은 말을 두 번 한다. */}
        {/* ★ **도구 목록으로 돌아가는 칸이 없었다**(2026-09-14 소유주 지적
            「radcalc 상단 메뉴에 다시 첫 계산도구 선택하는 화면으로 못 돌아가잖아」).
            허브로 가는 길이 로고 글자와 빵부스러기 둘뿐이었는데 **둘 다 눈에 안 띄는 자리**다.
            도구를 고르는 것은 이 lab 에서 가장 자주 하는 이동이므로 첫 칸을 준다. */}
        <nav class="ml-auto flex flex-wrap gap-x-3 gap-y-1 text-[13px]">
          <a href={u("/")} aria-current={here === u("/") ? "page" : undefined}
             class:list={["hover:text-ink", here === u("/") ? "font-semibold text-ink" : "text-ink-muted"]}>Calculators</a>
          <a href={u("/saved/")} class="text-ink-muted hover:text-ink">Saved</a>
          <a href={u("/methods/")} class="text-ink-muted hover:text-ink">Methods</a>
        </nav>
      </div>
    </header>

    {/* ★ tabindex="-1" 이 없으면 건너뛰기 링크가 **절반만 듣는다** — 주소는 #main 으로 가고
        화면도 내려가지만 **초점은 body 에 남아**, 다음 Tab 이 다시 쪽 맨 위로 돌아간다.
        키보드 이용자에게는 링크가 아무 일도 안 한 것과 같다(2026-09-14 실측으로 잡았다). */}
    <main id="main" tabindex="-1" class="mx-auto max-w-content px-4 py-8 focus:outline-none"><slot /></main>

    <footer class="mt-16 border-t border-line bg-panel">
      <div class="mx-auto max-w-content space-y-5 px-4 py-8 text-[13px]">
        <nav class="flex flex-wrap gap-x-4 gap-y-1.5">
          {TOOLS.map((t) => <a href={u(`/${t.slug}/`)} class="text-ink-muted hover:text-ink">{t.name}</a>)}
        </nav>
        <div>
          <p class="label">Data sources</p>
          <ul class="mt-1 space-y-0.5 text-ink-muted">
            {DATA_SOURCES.map((d) => (
              <li><a href={d.url} rel="noopener" class="hover:text-ink">{d.name}</a></li>
            ))}
          </ul>
        </div>
        <p class="text-ink-faint leading-relaxed">
          {SITE_NAME} is part of {UMBRELLA_NAME}. These calculators are for orientation and
          cross-checking. They <strong>do not replace</strong> an accredited calibration, a shielding
          design, a dose assessment, or a radiation survey by a qualified person.
        </p>
        <nav class="flex flex-wrap gap-x-4 gap-y-1.5 text-ink-faint">
          <a href={u("/disclaimer/")} class="hover:text-ink">Disclaimer</a>
          <a href={u("/methods/")} class="hover:text-ink">Methods and data</a>
          {/* ★ 개인정보·약관은 **플랫폼 층**이고 오리진 루트에는 없다 —
              `/privacy/`·`/terms/` 로 걸었다가 라이브에서 404 가 났다(2026-09-14 실측).
              플랫폼 문서가 사는 자리를 그대로 가리킨다. */}
          <a href="/radimeter/privacy/" class="hover:text-ink">Privacy</a>
          <a href="/radimeter/terms/" class="hover:text-ink">Terms</a>
          <a href="/radimeter/contact/" class="hover:text-ink">Contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
