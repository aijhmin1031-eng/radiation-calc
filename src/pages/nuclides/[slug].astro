---
import Base from "../../layouts/Base.astro";
import { u, DATA_SOURCES } from "../../lib/site";
import { ALL_KEYS, NUCLIDES, nuclidePage, slugOf, longName, decayWord, halfLifeText, elementName,
         belowCutoff, alphaSpread } from "../../lib/nuclides";
import { paragraphs, decayCaption, sectionHeads } from "../../lib/nuclide-prose";
import { nuclideSeo } from "../../lib/nuclide-seo";

export function getStaticPaths() {
  return ALL_KEYS.map((key) => ({ params: { slug: slugOf(key) }, props: { key } }));
}
const { key } = Astro.props as { key: string };
const p = nuclidePage(key);
const n = p.n;

/** ★ 검색 제목·설명은 **정본 한 곳**에서 만든다 — `lib/nuclide-seo.ts`.
 *  왜 그 문구인지(비어 있는 질의를 골랐다 · 숫자를 제목에 넣지 않는다 · Γ>0 을 자로
 *  쓰지 않는다)는 그 파일이 든다. 여기서는 쓰기만 한다. */
const seo = nuclideSeo(p);

const sig = (x: number, d = 3) => (Number.isFinite(x) ? x.toPrecision(d) : "—");
const mm = (cm: number) => (Number.isFinite(cm) ? (cm * 10).toPrecision(3) : "—");
/** ★ 산문용 — 위 `mm()` 은 **표 칸**에 쓰는 것이라 단위를 안 붙인다(열 머리글이 든다).
 *  그것을 문장에 그대로 쓰면 「10.3 of lead halves this spectrum」이 나간다(2026-09-20 실측으로
 *  잡았다 — 빌드도 게이트도 통과했고 **화면을 읽어야만** 보였다). */
const mmText = (cm: number) => (Number.isFinite(cm) ? `${(cm * 10).toPrecision(3)} mm` : "—");
const prose = paragraphs(p);
const shown = p.shares.slice(0, 14);
/** ★★ 147장의 **되풀이 설명**을 허브 한 곳으로 보냈다(2026-09-20). 그전에는 구획마다
 *  「방출확률이란 무엇인가」·「왜 스펙트럼으로 푸는가」·「narrow beam 이란」을 96장·96장·
 *  35장에서 **글자까지 같게** 되풀이했다. 심사자가 한 장을 열었을 때 남의 쪽에서 본 문장이
 *  **산문의 66.4%**(실측 중앙)였다.
 *  ★ 규칙은 `nuclide-prose.ts` 가 이미 세워 둔 것과 같다 — **낱장에는 이 핵종의 숫자만 둔다.**
 *    일반론은 `/nuclides/` 허브의 앵커로 보낸다. 캡션도 본문이다(그전 판단을 뒤집는다):
 *    96장에 같은 세 문장이 있으면 그것은 UI 가 아니라 되풀이다.
 *  ★ 남기는 경고는 **그 핵종의 숫자를 든 것**뿐이다 — 숫자가 없으면 그 줄이 아예 사라진다.
 *    없는 위험을 147번 경고하지 않는다. */
const cut = belowCutoff(key);
const H = sectionHeads(p);
const al = alphaSpread(key);
const pb = p.shields.find((s) => s.material === "lead");
const hubLinks = { lines: "/nuclides/#lines", hvl: "/nuclides/#hvl", tvl: "/nuclides/#tvl",
                   beta: "/nuclides/#beta", limits: "/nuclides/#limits" } as const;
const plural = (k: number, one: string, many: string) => (k === 1 ? one : many);
/** ★★ 계산기로 보내는 링크는 **이미 있는 복원 장치**(`?s=<base64 json>`)를 쓴다.
 *  처음에 `?n=Co-60` 으로 적었는데 그것을 읽는 코드가 **아무 데도 없었다** — 눌러도
 *  기본 핵종이 뜬다. 「없는 기능을 광고하지 않는다」(이 lab 이 `Saved` 에서 이미 밟았다).
 *  `encodeURIComponent` 를 반드시 건다 — base64 의 `+` 가 질의문자열에서 공백이 되면
 *  복원이 조용히 실패한다(형이 안 맞으면 `pick()` 이 기본값으로 떨어져 티도 안 난다). */
const prefill = (tool: string, inputs: Record<string, unknown>) =>
  `/${tool}/?s=${encodeURIComponent(Buffer.from(JSON.stringify(inputs), "utf8").toString("base64"))}`;

const TOOLS_FOR: { href: string; label: string; when: boolean; prefill?: boolean }[] = [
  { prefill: true, href: prefill("gamma-shielding", { nuclide: p.key }),  label: "Gamma dose rate and shielding", when: p.gamma > 0 },
  { prefill: true, href: prefill("beta", { nuclide: p.key }),             label: "Beta dose rate and shielding",  when: Boolean(n.beta?.length) },
  { prefill: true, href: prefill("decay", { nuclide: p.key }),            label: "Decay and half-life",           when: true },
  { prefill: true, href: prefill("specific-activity", { nuclide: p.key }), label: "Mass and activity",            when: true },
  { href: "/mda/", label: "Detection limits (MDA / MDC)", when: true },
];
const related = ALL_KEYS.filter((k) => k !== key && NUCLIDES[k].sym === n.sym).slice(0, 8);
---
<Base schema="TechArticle" title={seo.title} description={seo.description}>
  <nav class="tap-list mb-4 flex flex-wrap items-center gap-x-1.5 text-[12px] text-ink-faint">
    <a href={u("/")} class="hover:text-ink">Calculators</a> <span aria-hidden>/</span>
    <a href={u("/nuclides/")} class="hover:text-ink">Nuclides</a> <span aria-hidden>/</span> {p.key}
  </nav>

  <h1 class="text-[26px] font-semibold tracking-tight text-ink sm:text-[32px]">{longName(key)}</h1>
  <p class="mt-1 text-[15px] text-ink-muted">
    {p.key} · {elementName(n.sym)}, Z = {n.z}, A = {n.a}{n.iso ? ` · isomeric state ${n.iso}` : ""}
  </p>

  <section class="prose-doc mt-6 max-w-3xl text-[15px] leading-relaxed text-ink-muted">
    {prose.map((t) => <p set:html={t} />)}
  </section>

  <section class="mt-8 max-w-3xl">
    <h2 class="text-[20px] font-semibold text-ink">{H.figures}</h2>
    <table class="mt-3">
      <tbody>
        <tr><td>Half-life</td><td>{halfLifeText(n)} ({sig(n.t_half_s, 4)} s)</td></tr>
        <tr><td>Decay mode</td><td>{decayWord(n.decay)}</td></tr>
        <tr><td>Specific activity</td><td>{sig(n.sa_bq_g)} Bq/g ({sig(p.saCiPerG)} Ci/g)</td></tr>
        {p.gamma > 0 && <tr><td>Air kerma rate constant Γ (δ = 20 keV)</td><td>{sig(p.gamma)} mGy·m²/(GBq·h)</td></tr>}
        {p.gamma > 0 && <tr><td>Dose rate, 1 GBq at 1 m</td><td>{sig(p.doseAt1mPerGBq)} mGy/h</td></tr>}
        {p.gamma > 0 && <tr><td>Dose rate, 1 Ci at 1 m</td><td>{sig(p.doseAt1mPerCi)} mGy/h</td></tr>}
        {p.shares.length > 0 && <tr><td>Kerma-weighted mean photon energy</td><td>{sig(p.meanPhotonKeV, 4)} keV</td></tr>}
        {p.betaMaxMeV && <tr><td>Beta endpoint / mean</td><td>{sig(p.betaMaxMeV)} MeV / {sig((n.beta_mean_keV ?? 0) / 1000)} MeV</td></tr>}
      </tbody>
    </table>
  </section>

  {shown.length > 0 && (
    <section class="mt-8 max-w-3xl">
      <h2 class="text-[20px] font-semibold text-ink">Photon lines and what each contributes</h2>
      <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">
        {cut
          ? `${cut.count} further ${plural(cut.count, "line", "lines")} below the 20 keV cutoff, the highest at ` +
            `${cut.topKeV.toFixed(2)} keV and ${cut.iPct.toPrecision(3)}% emission probability in all, ` +
            `${plural(cut.count, "is", "are")} excluded here and from Γ.`
          : `No recorded line for ${p.key} falls below the 20 keV cutoff, so this table is the whole photon spectrum.`}
        {" "}<a href={u(hubLinks.lines)} class="underline">Why the two columns rank differently</a>.
      </p>
      <table class="mt-3">
        <thead><tr><th>Energy (keV)</th><th>Emission probability (%)</th><th>Share of dose rate (%)</th></tr></thead>
        <tbody>
          {shown.map((s) => (
            <tr><td>{s.eKeV.toFixed(2)}</td><td>{s.yPct}</td><td>{(s.share * 100).toFixed(2)}</td></tr>
          ))}
        </tbody>
      </table>
      {p.shares.length > shown.length && (
        <p class="mt-2 text-[13px] text-ink-faint">
          Showing the {shown.length} largest contributors of {p.shares.length} lines above the cutoff; the
          remainder together carry {((1 - shown.reduce((a, s) => a + s.share, 0)) * 100).toFixed(2)}% of the dose rate.
        </p>
      )}
    </section>
  )}

  {p.shields.length > 0 && (
    <section class="mt-8 max-w-3xl">
      <h2 class="text-[20px] font-semibold text-ink">Half- and tenth-value layers</h2>
      <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">
        Solved numerically across all {p.shares.length} {plural(p.shares.length, "line", "lines")}, narrow beam.
        {" "}<a href={u(hubLinks.hvl)} class="underline">Why not one representative energy</a>.
      </p>
      <table class="mt-3">
        <thead><tr><th>Material</th><th>HVL (mm)</th><th>TVL (mm)</th><th>TVL / HVL</th></tr></thead>
        <tbody>
          {p.shields.map((s) => (
            <tr>
              <td>{s.material}</td><td>{mm(s.hvlCm)}</td><td>{mm(s.tvlCm)}</td><td>{s.ratio.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-2 text-[13px] text-ink-faint">
        A single energy would give 3.32.
        {" "}<a href={u(hubLinks.tvl)} class="underline">What a spread of energies does instead</a>.
      </p>
    </section>
  )}

  {p.betaRanges.length > 0 && (
    <section class="mt-8 max-w-3xl">
      <h2 class="text-[20px] font-semibold text-ink">Beta range and bremsstrahlung</h2>
      <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">
        Katz–Penfold fit to the {sig(p.betaMaxMeV ?? NaN)} MeV endpoint — ±10%, and a stopping thickness
        rather than an attenuation length.
        {" "}<a href={u(hubLinks.beta)} class="underline">Why the material matters more than the thickness</a>.
      </p>
      <table class="mt-3">
        <thead><tr><th>Absorber</th><th>Range for the endpoint (mm)</th></tr></thead>
        <tbody>
          {p.betaRanges.map((r) => <tr><td>{r.material}</td><td>{mm(r.cm)}</td></tr>)}
        </tbody>
      </table>
      <table class="mt-4">
        <thead><tr><th>Shield material</th><th>Fraction of beta energy converted to X-rays</th></tr></thead>
        <tbody>
          <tr><td>acrylic (Z ≈ 6)</td><td>{(p.bremsLow * 100).toFixed(2)}%</td></tr>
          <tr><td>lead (Z = 82)</td><td>{(p.bremsLead * 100).toFixed(2)}%</td></tr>
        </tbody>
      </table>
    </section>
  )}

  {/* ★ `{n.alpha?.length && …}` 로 두면 배열이 **비었을 때 화면에 「0」이 찍힌다**(JSX 의 오래된
      함정 — `undefined` 는 안 그려지는데 `0` 은 그려진다). 지금 자료에 빈 배열은 없지만,
      수확이 한 번 바뀌면 147장 어딘가에 맨 `0` 이 뜨고 **빌드는 통과한다.** */}
  {Boolean(n.alpha?.length) && (
    <section class="mt-8 max-w-3xl">
      <h2 class="text-[20px] font-semibold text-ink">Alpha lines</h2>
      {al && (
        <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">
          {al.count === 1
            ? `One recorded line, ${al.topMeV.toPrecision(4)} MeV at ${al.topPct}% — monoenergetic as far as this dataset goes.`
            : `${al.count} recorded lines from ${al.loMeV.toPrecision(4)} to ${al.hiMeV.toPrecision(4)} MeV, ` +
              `the strongest ${al.topMeV.toPrecision(4)} MeV at ${al.topPct}% of ${al.totPct.toPrecision(4)}% total alpha emission.`}
        </p>
      )}
      <table class="mt-3">
        <thead><tr><th>Energy (MeV)</th><th>Emission probability (%)</th></tr></thead>
        <tbody>
          {/* ★ 위 `Boolean(n.alpha?.length)` 가 지키지만 **타입은 그 좁힘을 JSX 경계 밖으로
              옮기지 못한다** — `astro check` 가 여기서 걸린다(2026-09-16, 게이트를 살리며 드러났다).
              `?? []` 로 값 쪽에서 풀어 준다. 동작은 그대로다. */}
          {[...(n.alpha ?? [])].sort((a, b) => b[1] - a[1]).slice(0, 10).map((a) => (
            <tr><td>{(a[0] / 1000).toPrecision(5)}</td><td>{a[1]}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <section class="mt-8 max-w-3xl">
    <h2 class="text-[20px] font-semibold text-ink">{H.decay}</h2>
    {/* ★ 표에 **없는** 값만 든다 — 표는 반감기 배수와 남는 비율을 주고, 여기서는 그 배수의
        **경과 시간**과 평균수명을 준다. 표와 같은 것을 산문으로 되풀이하지 않는다.
        ★ 평균수명 / 반감기 = 1.44 는 **모든 핵종에서 같으므로 찍지 않는다**(82/6 과 같은 규칙). */}
    <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">{decayCaption(key)}</p>
    <table class="mt-3">
      <thead><tr><th>Elapsed</th><th>Fraction remaining</th></tr></thead>
      <tbody>
        {p.decayPoints.map((d) => (
          <tr><td>{d.label}</td><td>{d.frac < 1e-4 ? d.frac.toExponential(2) : (d.frac * 100).toPrecision(3) + " %"}</td></tr>
        ))}
        {p.timeTo.map((t) => <tr><td>Time to fall to {t.label}</td><td>{t.text}</td></tr>)}
      </tbody>
    </table>
  </section>

  <section class="mt-8 max-w-3xl">
    <h2 class="text-[20px] font-semibold text-ink">{H.limits}</h2>
    {/* ★★ 일반 경고 세 줄은 허브(`/nuclides/#limits`)로 보냈다 — 147장에 **글자까지 같게**
        서 있던 것이라 심사자가 읽는 산문의 되풀이 몫을 크게 키우고 있었다.
        ★ 대신 **이 쪽의 숫자를 든 줄**만 남긴다. 숫자가 없으면 그 줄이 사라지므로 쪽마다
          길이도 내용도 다르고, 경고가 추상이 아니라 **위에 인쇄된 값에 붙는다.**
        ★ 지우지 않고 옮긴 것이다 — 마지막 줄이 전문으로 데려간다(절대규칙 4 의 방어선). */}
    <ul class="mt-3 space-y-1.5 text-[15px] leading-relaxed text-ink-muted">
      {p.gamma > 0 && <li>{sig(p.doseAt1mPerGBq)} mGy/h at a metre — bare point source, no capsule, no self-absorption.</li>}
      {pb && <li>{mmText(pb.hvlCm)} of lead halves this spectrum, narrow beam, scatter not added back.</li>}
      {cut && (
        <li>Γ excludes {cut.count} {plural(cut.count, "line", "lines")} under 20 keV, carrying{" "}
          {cut.iPct.toPrecision(3)}% of all emissions.</li>
      )}
      {p.betaMaxMeV && (
        <li>{mmText(p.betaRanges[0].cm)} of {p.betaRanges[0].material} for the {sig(p.betaMaxMeV)} MeV
          endpoint: a ±10% fit, and not a skin dose.</li>
      )}
      {Boolean(n.alpha?.length) && <li>Alpha reaches nothing through skin — {p.key} is an intake problem, not an external one.</li>}
      <li><a href={u(hubLinks.limits)} class="underline">What every sheet leaves out</a>, internal dose included.</li>
    </ul>
  </section>

  <section class="mt-8 max-w-3xl">
    <h2 class="text-[20px] font-semibold text-ink">{H.tools}</h2>
    <ul class="mt-3 space-y-1.5">
      {TOOLS_FOR.filter((t) => t.when).map((t) => (
        <li><a href={u(t.href)} data-prefill={t.prefill ? p.key : undefined} class="underline text-[15px]">{t.label}</a></li>
      ))}
    </ul>
    {related.length > 0 && (
      <p class="mt-4 text-[14px] text-ink-muted">
        Other {elementName(n.sym)} nuclides:{" "}
        {related.map((k, i) => (
          <>{i > 0 ? ", " : ""}<a href={u(`/nuclides/${slugOf(k)}/`)} class="underline">{k}</a></>
        ))}
      </p>
    )}
    {/* ★ 허브의 같은 문단과 글자까지 겹쳐 있었다 — 한 문장으로 줄이고 정본으로 보낸다. */}
    <p class="mt-4 text-[14px] text-ink-muted">
      Computed from the {DATA_SOURCES[0].name} and the {DATA_SOURCES[1].name}.
      {" "}<a href={u("/methods/")} class="underline">Derivations and citations</a>.
    </p>
  </section>
</Base>
