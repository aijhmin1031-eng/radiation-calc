---
/** ★★ 작업계획(ALARA) 유효성 평가 보고서 — 쪽이 숫자를 손으로 들지 않는다.
 *  ★★★ 이 도구에는 **대조할 바깥 자료가 없다.** 그래서 보고서의 중심이 ① 유도
 *    ② **가정이 깨지는 자리를 수로 말하기** ③ 거부 셋이고, 그것을 쪽이 먼저 설명한다. */
import Base from "../../layouts/Base.astro";
import { u, DOI, DOI_URL } from "../../lib/site";
import { inverseSquare, distanceForRate, stayTime, collectiveDose, hvlFromMu, tvlFromMu } from "../../engine/alara";
import {
  DERIVATION_CASES, EXTENT_CASE, IDENTITY_CASES, WORKED_CASES, REFUSAL_CASES, UNVERIFIED,
  TOLERANCE_EXACT, TOLERANCE_WORKED,
} from "../../validation/alara.cases";
import { reportFor } from "../../validation/registry";
import { sci, relValue } from "../../validation/format";

const report = reportFor("alara")!;
let revision = (process.env.VERCEL_GIT_COMMIT_SHA ?? "").slice(0, 7);
if (!revision) {
  try {
    const { execSync } = await import("node:child_process");
    revision = execSync("git rev-parse --short HEAD", { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
  } catch { revision = ""; }
}

const RATES = [0.01, 0.5, 2, 137];
const DISTS = [0.1, 1, 3.7, 50];
const MUS = [0.01, 0.5, 1.2, 37];

/* ── 항등식 — 격자 전수에서 최악을 잡는다 ── */
const idRun = (kind: string, r: number, d: number, mu: number) => {
  if (kind === "doubleDistance") return inverseSquare(r, d, 2 * d) / inverseSquare(r, d, d);
  if (kind === "roundTrip") return inverseSquare(r, d, distanceForRate(r, d, r / 4)) / (r / 4);
  if (kind === "rateLinear") return inverseSquare(3 * r, d, 2 * d) / inverseSquare(r, d, 2 * d);
  if (kind === "tvlOverHvl") return tvlFromMu(mu) / hvlFromMu(mu);
  if (kind === "muInverse") return hvlFromMu(2 * mu) / hvlFromMu(mu);
  if (kind === "stayInverse") return stayTime(1, r / 2) / stayTime(1, r);
  if (kind === "collectiveSplit")
    return collectiveDose([{ workers: 3, hours: 1, rate: r }, { workers: 3, hours: 3, rate: r }])
         / collectiveDose([{ workers: 3, hours: 4, rate: r }]);
  return collectiveDose([{ workers: 6, hours: 4, rate: r }]) / collectiveDose([{ workers: 3, hours: 4, rate: r }]);
};
let idChecks = 0, idWorst = 0, idWorstWhat = "";
const identities = IDENTITY_CASES.map((c) => {
  let worst = 0;
  for (const r of RATES) for (const d of DISTS) for (const mu of MUS) {
    idChecks += 1;
    const v = relValue(idRun(c.kind, r, d, mu), c.expect);
    if (v > worst) worst = v;
    if (v > idWorst) { idWorst = v; idWorstWhat = `${c.id} @rate=${r}, d=${d}, µ=${mu}`; }
  }
  return { c, tool: idRun(c.kind, 2, 1, 1.2), worst };
});

/* ── ★ 가정이 깨지는 자리 — 정확한 수학 ── */
const ratioAt = (dOverL: number) => { const x = 1 / (2 * dOverL); return Math.atan(x) / x; };
const overAt = (dOverL: number) => 1 / ratioAt(dOverL) - 1;
const extentRows = EXTENT_CASE.ratios.map((r) => ({ r, ratio: ratioAt(r), over: overAt(r) }));
const needFor = (t: number) => {
  let lo = 0.1, hi = 1000;
  for (let i = 0; i < 200; i++) { const m = (lo + hi) / 2; if (overAt(m) > t) lo = m; else hi = m; }
  return (lo + hi) / 2;
};
const extentTargets = EXTENT_CASE.targets.map((t) => ({ t, d: needFor(t) }));
const extentOk = extentRows.every((x) => x.ratio < 1) && overAt(1) > EXTENT_CASE.atOneL_above
  && overAt(3) < EXTENT_CASE.atThreeL_below;

/* ── 손계산 · 거부 ── */
const worked = WORKED_CASES.map((c) => {
  const i = c.input;
  const got = c.kind === "rate" ? inverseSquare(i.rate1, i.d1, i.d2)
    : c.kind === "distance" ? distanceForRate(i.rate1, i.d1, i.target)
    : c.kind === "stay" ? stayTime(i.doseLimit, i.doseRate)
    : c.kind === "collective" ? collectiveDose(c.tasks!)
    : c.kind === "hvl" ? hvlFromMu(i.mu) : tvlFromMu(i.mu);
  return { c, got, diff: relValue(got, c.expect) };
});
const refusals = REFUSAL_CASES.map((c) => {
  const a = c.args;
  const got = c.kind === "rate" ? inverseSquare(a.rate1, a.d1, a.d2)
    : c.kind === "distance" ? distanceForRate(a.rate1, a.d1, a.target)
    : c.kind === "stay" ? stayTime(a.doseLimit, a.doseRate)
    : c.kind === "collective" ? collectiveDose(c.tasks!)
    : hvlFromMu(a.mu);
  return { c, refused: Number.isNaN(got), got };
});
/** ★ 「정확히 0 일 때만 무제한」 — 이웃한 나쁜 입력을 함께 센다. */
const unlimitedOk = stayTime(20, 0) === Infinity
  && [NaN, -1, Infinity, -Infinity].every((x) => Number.isNaN(stayTime(20, x)));

const checks = DERIVATION_CASES.length + idChecks + extentRows.length + extentTargets.length
  + worked.length + refusals.length + 1;
const allPass = idWorst < TOLERANCE_EXACT && extentOk && unlimitedOk
  && worked.every((w) => w.diff < TOLERANCE_WORKED) && refusals.every((r) => r.refused);

const title = "ALARA validation — a tool with no data to check against";
const description =
  "Inverse square, stay time and collective dose derived rather than compared, with the point-source assumption turned into a distance criterion and every input that has no answer enumerated.";
---
<Base title={title} description={description} schema="TechArticle">
  <nav class="tap-list mb-4 flex flex-wrap items-center gap-x-1.5 text-[12px] text-ink-faint">
    <a href={u("/")} class="hover:text-ink">Calculators</a> <span aria-hidden>/</span>
    <a href={u("/validation/")} class="hover:text-ink">Validation</a> <span aria-hidden>/</span> Work planning
  </nav>

  <h1 class="text-[26px] font-semibold tracking-tight text-ink sm:text-[32px]">
    Validation of the work planning calculator
  </h1>
  <p class="mt-2 max-w-3xl text-[15px] leading-relaxed text-ink-muted">
    This calculator uses no nuclear data, no empirical fit and no standard's constants, so there is
    nothing published to compare it against. What can be done instead is to derive every expression,
    turn its one assumption into a number a planner can use, and enumerate every input for which
    there is no answer.
  </p>

  <dl class="card mt-6 grid max-w-3xl gap-x-6 gap-y-2 p-4 text-[13px] sm:grid-cols-[11rem_minmax(0,1fr)]">
    <dt class="text-ink-faint">Subject</dt>
    <dd class="text-ink-muted">The work planning calculator at <a href={u("/alara/")} class="underline">{u("/alara/")}</a> and the engine module <code>src/engine/alara.ts</code>.</dd>
    <dt class="text-ink-faint">Report date</dt>
    <dd class="text-ink-muted">{report.validatedOn}</dd>
    <dt class="text-ink-faint">Source revision</dt>
    <dd class="num text-ink-muted">{revision || "not recorded in this build"}</dd>
    <dt class="text-ink-faint">Archived source</dt>
    <dd class="text-ink-muted"><a href={DOI_URL} rel="noopener" class="underline">{DOI}</a></dd>
    <dt class="text-ink-faint">Checks performed</dt>
    <dd class="num text-ink-muted">{checks}</dd>
    <dt class="text-ink-faint">Acceptance criteria</dt>
    <dd class="text-ink-muted">
      Geometry and arithmetic: relative difference below <span class="num">{TOLERANCE_EXACT}</span>.
      Worked cases: below <span class="num">{TOLERANCE_WORKED}</span>. No accuracy criterion applies
      to the point-source assumption; its cost is measured instead.
    </dd>
    <dt class="text-ink-faint">Not established</dt>
    <dd class="num text-ink-muted">{UNVERIFIED.length} items, listed at the end</dd>
    <dt class="text-ink-faint">Result</dt>
    <dd class={allPass ? "font-semibold text-ink" : "font-semibold text-warn"}>
      {allPass ? "All checks pass." : "One or more checks fail — see the tables below."}
    </dd>
  </dl>

  <section class="prose-doc mt-10 max-w-3xl text-[15px] leading-relaxed text-ink-muted">
    <h2>Scope, and why this report has no comparison table</h2>
    <p>
      The other five reports on this site all end up comparing against something: a definition, an
      evaluated data file, a published constant, a worked example in a standard. This one cannot,
      and saying so plainly is more useful than manufacturing a comparison.
    </p>
    <p>
      The inverse square law is geometry. Stay time is a division. Collective dose is a sum. The
      half-value layer is a rearrangement of the exponential. None of them has a reference value to
      look up, because none of them contains a measured quantity — everything on this screen is
      either entered by the user or follows from the four operations.
    </p>
    <p>
      That changes what validation means here. A tool with no data cannot be wrong about data; it can
      be wrong about <strong>where its assumption stops holding</strong>, and about
      <strong>what it does with inputs that have no answer</strong>. Those are the two things this
      report spends its length on, and they are where all nine defects it found were.
    </p>

    <h2>The expressions, derived</h2>
    <div class="not-prose my-3 space-y-5">
      {DERIVATION_CASES.map((c) => (
        <div class="card p-4">
          <p class="text-[14px] font-semibold text-ink"><span class="num">{c.id}</span> — {c.title}</p>
          <p class="mt-0.5 text-[12px] text-ink-faint">In the code: {c.where}</p>
          <ol class="mt-2 list-decimal space-y-1 pl-5 text-[14px] leading-relaxed text-ink-muted">
            {c.steps.map((s) => <li>{s}</li>)}
          </ol>
        </div>
      ))}
    </div>

    <h2>Turning “assume a point source” into a distance</h2>
    <p>
      Every inverse-square calculator carries a caveat that the source must be small compared with
      the distance. As a sentence it is useless: a planner needs to know whether three metres from a
      one-metre weld is close enough. That question has an exact answer, and no external data is
      needed to get it.
    </p>
    <p>
      For a uniform line source of length L, integrating along the line gives a dose rate
      proportional to (2/(L·d))·arctan(L/(2d)) at perpendicular distance d from the midpoint.
      Dividing by the point-source expression leaves arctan(x)/x with x = L/(2d), which is below one
      everywhere and rises to one as the distance grows.
    </p>
    <div class="not-prose my-3 pin-first table-fit">
      <table>
        <thead>
          <tr><th class="text-right">Distance<br />[source lengths]</th>
            <th class="text-right">Exact ÷<br />point source</th>
            <th class="text-right">Point source<br />overestimates by</th></tr>
        </thead>
        <tbody>
          {extentRows.map((x) => (
            <tr>
              <td class="num whitespace-nowrap text-right text-ink">{x.r}</td>
              <td class="num whitespace-nowrap text-right text-ink">{x.ratio.toFixed(6)}</td>
              <td class={x.over > 0.05 ? "num whitespace-nowrap text-right font-semibold text-warn" : "num whitespace-nowrap text-right"}>{(x.over * 100).toFixed(3)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Read the other way round, that is a rule a planner can apply:
    </p>
    <div class="not-prose my-3 pin-first table-fit">
      <table>
        <thead><tr><th class="text-right">To keep the overestimate under</th><th class="text-right">stand at least</th></tr></thead>
        <tbody>
          {extentTargets.map((x) => (
            <tr>
              <td class="num whitespace-nowrap text-right text-ink">{(x.t * 100).toFixed(1)}%</td>
              <td class="num whitespace-nowrap text-right text-ink">{x.d.toFixed(2)} source lengths</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Two things follow. One source length away is <strong>not</strong> enough — the error there is
      {" "}<span class="num">{(overAt(1) * 100).toFixed(1)}%</span>. And the error is always in the
      <strong>safe direction</strong>: the point approximation reports more dose than an extended
      source actually delivers, so a plan built on it is conservative. Neither statement is in the
      tool's caveat text, and both are more useful than the caveat.
    </p>
    <p>
      This holds for a line, which covers a pipe run or a weld. A disc or a volume gives a different
      answer, and only the line is computed here — it is listed at the end among what this report does
      not establish, along with air attenuation and scatter, which work in opposite directions and so
      do not cancel.
    </p>

    <h2>Identities</h2>
    <p>
      Each is checked across a grid of {RATES.length} dose rates, {DISTS.length} distances and
      {" "}{MUS.length} attenuation coefficients — {idChecks} comparisons in total, worst difference
      {" "}<span class="num">{idWorst === 0 ? "0" : idWorst.toExponential(2)}</span>
      {idWorstWhat ? ` (${idWorstWhat})` : ""}.
    </p>
    <div class="not-prose my-3 pin-first table-fit">
      <table>
        <thead>
          <tr><th class="text-left">Identity</th><th class="text-right">Hand</th><th class="text-right">Tool</th><th class="text-right">Worst<br />difference</th></tr>
        </thead>
        <tbody>
          {identities.map(({ c, tool, worst }) => (
            <tr>
              <td class="font-normal text-ink">{c.title}
                <span class="num mt-0.5 block text-[11px] font-normal text-ink-faint">{c.id}</span></td>
              <td class="num whitespace-nowrap text-right text-ink">{sci(c.expect)}</td>
              <td class="num whitespace-nowrap text-right text-ink">{sci(tool)}</td>
              <td class="num whitespace-nowrap text-right">{worst === 0 ? "0" : worst.toExponential(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <details class="not-prose my-3 rounded-md border border-line bg-surface px-3 py-2 text-[14px]">
      <summary class="cursor-pointer font-medium text-ink">Derivations of the identities</summary>
      <div class="mt-3 space-y-4">
        {IDENTITY_CASES.map((c) => (
          <div>
            <p class="text-[13px] font-semibold text-ink"><span class="num">{c.id}</span> — {c.title}</p>
            <ol class="mt-1 list-decimal space-y-0.5 pl-5 text-ink-muted">{c.steps.map((s) => <li>{s}</li>)}</ol>
          </div>
        ))}
      </div>
    </details>

    <h2>Worked cases</h2>
    <div class="not-prose my-3 pin-first table-fit">
      <table>
        <thead><tr><th class="text-left">Case</th><th class="text-right">By hand</th><th class="text-right">Tool</th><th class="text-right">Difference</th></tr></thead>
        <tbody>
          {worked.map(({ c, got, diff }) => (
            <tr>
              <td class="font-normal text-ink">{c.title}
                <span class="num mt-0.5 block text-[11px] font-normal text-ink-faint">{c.id}</span></td>
              <td class="num whitespace-nowrap text-right text-ink">{sci(c.expect, 11)} {c.unit}</td>
              <td class="num whitespace-nowrap text-right text-ink">{sci(got, 11)} {c.unit}</td>
              <td class="num whitespace-nowrap text-right">{diff === 0 ? "0" : diff.toExponential(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="not-prose my-3 space-y-5">
      {WORKED_CASES.map((c) => (
        <div class="card p-4">
          <p class="text-[14px] font-semibold text-ink"><span class="num">{c.id}</span> — {c.title}</p>
          <ol class="mt-2 list-decimal space-y-1 pl-5 text-[14px] leading-relaxed text-ink-muted">
            {c.steps.map((s) => <li>{s}</li>)}
          </ol>
        </div>
      ))}
    </div>

    <h2>Where the calculator must refuse — all nine were open</h2>
    <p>
      In a tool with no data, this is where the defects are. Every one of the nine below returned a
      number that looked like an answer.
    </p>
    <p>
      <strong>One of them is worth dwelling on.</strong> On 14 September the stay time was fixed so
      that a missing dose rate no longer reported “unlimited” — the guard had asked whether the rate
      was greater than zero, and a not-a-number fails that test, so it fell through to the unbounded
      branch. A <em>negative</em> rate fails the same test for the same reason, and it was still
      falling through five days later. Half the defect was fixed and half was left.
    </p>
    <p>
      The lesson has been written into the engine: when a guard is repaired for one bad input, every
      other input that reaches the same branch has to be counted at the same time. Here the branch is
      reached by not-a-number, by negatives and by infinities alike, and the correct behaviour differs
      only for exactly zero — which genuinely does mean unbounded.
    </p>
    <div class="not-prose my-3 pin-first table-fit">
      <table>
        <thead><tr><th class="text-left">Input</th><th class="text-left">Why there is no answer</th><th class="text-right">Refused</th></tr></thead>
        <tbody>
          {refusals.map(({ c, refused }) => (
            <tr>
              <td class="font-normal text-ink">{c.title}
                <span class="num mt-0.5 block text-[11px] font-normal text-ink-faint">{c.id}</span></td>
              <td>{c.why}</td>
              <td class={refused ? "whitespace-nowrap text-right text-ink" : "whitespace-nowrap text-right font-semibold text-warn"}>{refused ? "yes" : "no"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      And the one case that must <em>not</em> refuse: a dose rate of exactly zero gives an unbounded
      stay time, because the budget is never spent. The engine returns infinity there and
      not-a-number for every other non-positive value, which is
      {" "}<strong>{unlimitedOk ? "what it does" : "not what it does"}</strong>.
    </p>

    <h2>What this report does not establish</h2>
    <div class="not-prose my-3 pin-first table-fit">
      <table>
        <thead><tr><th class="text-left">Not established</th><th class="text-left">Why</th></tr></thead>
        <tbody>
          {UNVERIFIED.map((v) => (
            <tr>
              <td class="font-normal text-ink">{v.what}
                <span class="num mt-0.5 block text-[11px] font-normal text-ink-faint">{v.id}</span></td>
              <td>{v.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
